  if (!groundIO) return fx.mountAll(root);
  const seen = new Promise(r => groundWaiters.push(r));
  for (const el of els) {
    let st = grounded.get(el);
    if (st) {
      // again (a theme change): draw it once more in the new colours
      st.dirty = true; st.gen++;
