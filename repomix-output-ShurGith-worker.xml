/* the demo page of a scene object: a hero with the object beside the copy, then the object as large
   card panels. Colours come from the palette the switcher sets on :root. */
:root {
  --bg: #dfdedb; --surface: #d3d2ce; --ink: #26251e; --muted: #5f5d55; --accent: #2456d6; --accent-ink: #ffffff;
  --line: color-mix(in oklab, var(--ink) 13%, transparent);
  --line-2: color-mix(in oklab, var(--ink) 24%, transparent);
  --font: "Geist", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  --mono: "Geist Mono", ui-monospace, SFMono-Regular, Consolas, monospace;
  --gut: 24px;
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.5 var(--font); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
button { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.wrap { max-width: 1368px; margin: 0 auto; padding: 0 var(--gut); }

.top { border-bottom: 1px solid var(--line); }
.top .wrap { display: flex; align-items: center; gap: 16px; min-height: 60px; flex-wrap: wrap; padding-top: 10px; padding-bottom: 10px; }
.top b { font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
.top .kind { color: var(--muted); font-size: 14px; }
.top .controls { margin-left: auto; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.seg { display: inline-flex; padding: 3px; border-radius: 10px; box-shadow: inset 0 0 0 1px var(--line); }
.seg button { height: 30px; border: 0; background: transparent; padding: 0 11px; border-radius: 7px; cursor: pointer; color: var(--muted); font-size: 13.5px; }
