  .duo .card { grid-column: 9 / span 4; }
  .obj:nth-of-type(even) .big { grid-column: 5 / span 8; grid-row: 1; }
  .obj:nth-of-type(even) .duo .card { grid-column: 1 / span 4; grid-row: 1; }
