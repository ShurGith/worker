/* Hero: Settled, the text on one half and the product on the other */
.hero { display: grid; align-items: center; min-height: calc(100dvh - var(--nav-h)); padding-block: var(--space-xl); box-sizing: border-box; }
.hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--space-2xl); align-items: center; }
.hero__text { display: grid; gap: var(--space-lg); justify-items: start; }
.hero h1 { max-width: none; line-height: 1.02; }
.hang { margin-left: -0.46em; }
.hero .lead { max-width: 34ch; color: var(--color-ink-2); }
.actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-xs); }

/* The built product: one picture that scales as a whole; every inner length is in em of a design pixel times ten */
.slot { margin: 0; container-type: inline-size; }
.lifted { border-radius: var(--radius-card); box-shadow: var(--shadow-lift); outline: 1px solid var(--app-line); outline-offset: -1px; }
.app[data-slot] { background: var(--color-paper); }
.app--hero { aspect-ratio: 68 / 60; }
.ui { height: 100%; display: flex; flex-direction: column; font-size: calc(100cqi / 68); color: var(--color-ink); line-height: 1.35; }
.ui svg { width: 1.6em; height: 1.6em; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.fig { font-family: var(--font-outlier); font-weight: 400; font-variant-numeric: tabular-nums; }

.ui__bar { display: flex; align-items: center; gap: 2em; height: 5.6em; padding: 0 2.4em; border-bottom: 1px solid var(--color-rule); font-size: 1.3em; font-weight: 500; }
.ui__bar svg { width: 1.3em; height: 1.3em; }
.ui__mark { font-weight: 600; font-size: 1.25em; letter-spacing: -0.03em; }
.ui__chips { display: flex; gap: 0.4em; }
.ui__chip { display: inline-flex; align-items: center; gap: 0.5em; padding: 0.45em 0.9em; border-radius: var(--radius-pill); color: var(--color-muted); }
.ui__chip.is-on { background: var(--color-paper-2); color: var(--color-ink); }
.ui__badge { display: inline-grid; place-items: center; min-width: 1.6em; height: 1.6em; padding: 0 0.4em; border-radius: var(--radius-pill); background: var(--color-accent); color: var(--color-accent-ink); font-size: 0.8em; font-weight: 600; box-sizing: border-box; }
.ui__input { display: inline-flex; align-items: center; gap: 0.6em; white-space: nowrap; margin-left: auto; height: 2.6em; padding: 0 1em; border: 1px solid var(--color-rule); border-radius: var(--radius-pill); color: var(--color-muted); font-weight: 400; }
.ui__control { display: inline-flex; align-items: center; gap: 0.4em; white-space: nowrap; height: 2.6em; padding: 0 1.1em 0 0.9em; border-radius: var(--radius-pill); background: var(--color-ink); color: var(--color-paper); }

.ui__head { display: flex; align-items: center; gap: 2em; padding: 2.4em 2.4em 1.6em; }
.ui__title { font-size: 2.4em; font-weight: 600; letter-spacing: -0.025em; line-height: 1; }
.ui__tags { display: flex; gap: 0.6em; font-size: 1.3em; font-weight: 500; }
.ui__tag { padding: 0.35em 0.9em; border: 1px solid var(--color-rule); border-radius: var(--radius-pill); color: var(--color-muted); }
.ui__tag.is-on { border-color: var(--color-ink); color: var(--color-ink); }
.ui__owed { display: grid; gap: 0.2em; margin-left: auto; text-align: right; font-size: 1.2em; font-weight: 500; color: var(--color-muted); }
.ui__owed b { font-size: 1.35em; color: var(--color-ink); }

.ledger { padding: 0 2.4em; font-size: 1.45em; }
.ledger__row { display: grid; grid-template-columns: 4.2em minmax(0, 1fr) 5.2em 7.4em 7.6em; align-items: center; column-gap: 1.2em; min-height: 3.6em; border-top: 1px solid var(--color-rule); }
.ledger__row--head { min-height: 2.6em; border-top: 0; font-size: 0.86em; font-weight: 500; color: var(--color-muted); }
.ledger__row .r { text-align: right; }
.ledger__row .late { color: var(--color-accent-2); }
.ledger__row.is-open { margin: 0 -1em; padding: 0 1em; border-radius: 0.6em; border-top-color: transparent; background: color-mix(in oklab, var(--color-accent) 16%, var(--color-paper)); }
.ledger__row.is-open + .ledger__row { border-top-color: transparent; }
.status { display: inline-block; padding: 0.3em 0.75em; border: 1px solid var(--color-rule-2); border-radius: var(--radius-pill); font-size: 0.95em; font-style: normal; font-weight: 500; white-space: nowrap; }
.status--late { border-color: var(--color-accent); background: var(--color-accent); color: var(--color-accent-ink); }
.status--done { border-color: var(--color-ink); background: var(--color-ink); color: var(--color-paper); }

.chase { grid-column: 1 / -1; display: flex; align-items: center; gap: 1.4em; padding: 0.3em 0 1.2em; font-size: 0.95em; font-weight: 500; white-space: nowrap; }
.chase__status { display: inline-flex; align-items: center; gap: 0.45em; flex-shrink: 0; color: var(--color-ink-2); }
.chase__status svg { width: 1.2em; height: 1.2em; color: var(--color-muted); }
.chase__status b { font-weight: 400; color: var(--color-muted); }
.chase__status.is-late b { color: var(--color-accent-2); }
.chase__status.is-now { padding: 0.3em 0.85em 0.3em 0.65em; border-radius: var(--radius-pill); background: var(--color-accent); color: var(--color-accent-ink); }
.chase__status.is-now svg { color: var(--color-accent-ink); }
.chase__status.is-now b { color: var(--color-accent-ink); }
.chase__note { margin-left: auto; color: var(--color-muted); font-weight: 400; }

/* The questions, in the order a freelancer asks them */
.q--work { padding-top: var(--section-gap-s); }
.q--receive { padding-top: var(--section-gap-l); }
.q--replies { padding-top: var(--section-gap); }
.q--paid { padding-block: var(--section-gap-l) var(--section-gap); }
.q__head { display: grid; gap: var(--space-md); margin-bottom: var(--space-2xl); }
.split, .rows, .band__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap-columns); }
.split { align-items: center; }
.split__text { display: grid; gap: var(--space-md); align-content: center; }
.split--work .split__text { grid-column: 1 / span 5; }
.split--work .photo { grid-column: 6 / span 7; }
.split--replies .app--replies { grid-column: 1 / span 8; }
.split--replies .split__text { grid-column: 9 / span 4; }

.photo { margin: 0; aspect-ratio: 4 / 3; border-radius: var(--radius-card); }
.photo > img { border-radius: inherit; outline: 1px solid color-mix(in oklab, var(--color-ink) 6%, transparent); outline-offset: -1px; }

/* The client's side: the reminder and the invoice it links to, straight on the paper */
.showcase { margin: 0; }
.showcase figcaption { margin-top: var(--space-md); font-size: var(--text-sm); font-weight: 500; color: var(--color-muted); }
.client { aspect-ratio: 1312 / 640; }
.client[data-slot] { background: var(--color-paper); }
.client__in { height: 100%; box-sizing: border-box; display: flex; align-items: flex-start; gap: 4.8em; padding: 2.4em; font-size: calc(100cqi / 131.2); color: var(--color-ink); line-height: 1.4; }
.doc { background: var(--color-paper); border-radius: var(--radius-card); box-shadow: var(--shadow-lift); outline: 1px solid var(--app-line); outline-offset: -1px; }
.doc p { margin: 0; max-width: none; }
.mail { display: grid; flex: 76 1 0; min-width: 0; }
.mail__head { display: grid; gap: 1.6em; padding: 3.2em 4em 2.4em; border-bottom: 1px solid var(--color-rule); }
.mail__subject { font-size: 2.6em; font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; }
.mail__meta { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.45em 1.4em; font-size: 1.5em; }
.mail__meta span:nth-child(odd) { color: var(--color-muted); }
.mail__body { display: grid; gap: 1.8em; padding: 3.2em 4em 3.6em; line-height: 1.55; }
.mail__body p { font-size: 1.7em; }
.mail__link { justify-self: start; display: inline-flex; align-items: center; gap: 0.5em; margin-top: 0.6em; padding: 0.75em 1.25em 0.75em 1em; border-radius: var(--radius-pill); background: var(--color-ink); color: var(--color-paper); font-size: 1.5em; font-weight: 500; }
.doc svg { width: 1.15em; height: 1.15em; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.mail__foot { padding: 2em 4em 2.4em; border-top: 1px solid var(--color-rule); color: var(--color-muted); }
.mail__foot span { font-size: 1.3em; }
.inv { display: grid; flex: 50 1 0; min-width: 0; gap: 3.2em; padding: 3.6em; margin-top: 4em; }
.inv__top { display: flex; align-items: center; justify-content: space-between; }
.inv__title { font-size: 2.8em; font-weight: 600; letter-spacing: -0.02em; }
.inv__title b { margin-left: 0.2em; }
.inv .status { font-size: 1.35em; }
.inv__parties, .inv__dates { display: flex; gap: 2em; font-size: 1.4em; color: var(--color-muted); }
.inv__parties span, .inv__dates span { flex: 1 1 0; display: grid; gap: 0.3em; }
.inv__parties b, .inv__dates b { color: var(--color-ink); font-weight: 500; }
.inv__dates b.late, .thread__steps b.late { color: var(--color-accent-2); }
.inv__lines { display: grid; grid-template-columns: minmax(0, 1fr) auto; font-size: 1.5em; border-top: 1px solid var(--color-ink); }
.inv__lines span { padding: 0.85em 0; border-bottom: 1px solid var(--color-rule); }
.inv__lines .fig { text-align: right; }
.inv__lines .inv__total { border-bottom: 0; font-weight: 600; }
.inv__pay { font-size: 1.35em; color: var(--color-muted); }

/* The replies screen */
.app--replies { aspect-ratio: 864 / 500; }
.app--replies .ui { font-size: calc(100cqi / 86.4); }
.inbox { flex: 1; display: grid; grid-template-columns: 30em minmax(0, 1fr); min-height: 0; }
.inbox__list { display: grid; align-content: start; gap: 0.4em; padding: 1.4em 1.2em; border-right: 1px solid var(--color-rule); }
.inbox__item { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.35em 1em; padding: 1.1em 1.3em; border-radius: 0.6em; font-size: 1.35em; }
.inbox__item b { font-weight: 600; }
.inbox__item .fig { grid-row: 2; color: var(--color-muted); }
.inbox__date { grid-column: 2; grid-row: 1; color: var(--color-muted); }
.inbox__line { grid-column: 1 / -1; color: var(--color-ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.inbox__item.is-on { background: var(--color-paper-2); }
.thread { display: grid; align-content: start; gap: 2.4em; padding: 2.8em 3.2em; }
.thread__head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 0.5em 1em; }
.thread__who { font-size: 2.4em; font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; }
.thread__what { grid-row: 2; display: flex; gap: 1em; font-size: 1.4em; color: var(--color-muted); }
.thread__what b { color: var(--color-ink); font-weight: 400; }
.thread__head .status { grid-row: 1 / span 2; grid-column: 2; font-size: 1.3em; }
.thread__steps { list-style: none; margin: 0; padding: 0; font-size: 1.45em; border-top: 1px solid var(--color-ink); }
.thread__steps li { display: grid; grid-template-columns: 1.4em minmax(0, 1fr) auto; align-items: center; column-gap: 0.8em; padding: 0.85em 0; border-bottom: 1px solid var(--color-rule); }
.thread__steps svg { width: 1.1em; height: 1.1em; color: var(--color-muted); }
.thread__steps b { font-weight: 400; color: var(--color-muted); }
.thread__steps .is-reply { border-bottom: 0; }
.thread__steps .is-reply svg, .thread__steps .is-reply span { color: var(--color-accent-2); }
.thread__quote { grid-column: 2 / -1; margin: 0.7em 0 0; padding: 1em 1.2em; border-radius: 0.6em; background: var(--color-paper-2); }
.thread__quote p { margin: 0; color: var(--color-ink); line-height: 1.45; }
.thread__quote cite { display: block; margin-top: 0.5em; font-size: 0.85em; font-style: normal; color: var(--color-muted); }

/* One invoice from sent to paid, as rows */
.rows { align-items: start; }
.rows__head { grid-column: 1 / span 4; display: grid; gap: var(--space-md); }
.life { grid-column: 5 / span 8; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--color-ink); }
.life li { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr) auto; align-items: center; column-gap: var(--gap-columns); min-height: 88px; border-bottom: 1px solid var(--color-rule); }
.life__date { font-size: var(--text-lead); color: var(--color-muted); }
.life__what { font-size: var(--text-title); font-weight: 500; letter-spacing: -0.01em; line-height: 1.25; }
.life .status { font-size: var(--text-sm); }

/* The price, on the one ink band */
.band { padding-block: var(--section-gap-s); background: var(--color-ink); color: var(--color-paper); }
.band__grid { align-items: end; }
.band__text { grid-column: 1 / span 7; display: grid; gap: var(--space-md); }
.band h2 { color: var(--color-paper); }
.price { font: var(--display-weight) var(--text-display)/1 var(--font-display); letter-spacing: var(--tracking-display); font-variant-numeric: tabular-nums; color: var(--color-paper); }
.band__line { font-size: var(--text-lead); color: var(--color-paper-3); }
.signup { grid-column: 8 / span 5; display: grid; gap: var(--space-xs); min-width: 0; }
.signup label { font-size: var(--text-sm); font-weight: 500; color: var(--color-paper-3); }
.signup__row { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
.signup input { flex: 1 1 12rem; min-width: 0; width: 100%; height: 48px; padding: 0 var(--space-md); border: 1px solid var(--color-muted); border-radius: var(--radius-input); background: var(--color-paper); color: var(--color-ink); font-size: var(--text-md); outline: 2px solid transparent; outline-offset: -3px; transition: background-color var(--dur-short) var(--ease-out); }
.signup input:hover { background: var(--color-paper-2); }
.signup input:focus-visible { outline-color: var(--color-focus); }
.signup input[aria-invalid] { border-color: var(--color-error); }
.signup input:disabled { opacity: 0.55; cursor: not-allowed; }
.signup__help { min-height: 1lh; margin-top: var(--space-2xs); font-size: var(--text-sm); color: var(--color-paper-3); }
.btn--invert { background: var(--color-paper); color: var(--color-ink); }
.btn--invert:hover { background: var(--color-paper-2); }

/* The mast */
.mast { padding-block: var(--section-gap-s) var(--space-2xl); }
.mast__mark { margin-bottom: var(--space-2xl); font: var(--display-weight) clamp(7rem, 17vw, 15rem)/0.9 var(--font-display); letter-spacing: -0.045em; color: var(--color-ink); }
.mast__row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-lg); padding-top: var(--space-lg); border-top: 1px solid var(--color-rule); }
.mast__links { display: flex; flex-wrap: wrap; gap: var(--space-lg); }
.mast__links a { font-weight: 500; text-decoration-color: transparent; text-underline-offset: 0.3em; transition: text-decoration-color var(--dur-short) var(--ease-out); }
.mast__links a:hover { text-decoration-color: var(--color-accent-2); }
.mast__links a:focus-visible { outline: 2px solid var(--color-focus); outline-offset: var(--space-2xs); border-radius: var(--space-3xs); }
.mast__legal { font-size: var(--text-sm); color: var(--color-muted); }
.mast__credit { margin-top: var(--space-md); font-size: var(--text-sm); line-height: 1.55; color: var(--color-muted); }
.mast__credit a { color: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; text-decoration-color: color-mix(in oklab, currentColor 40%, transparent); }
.mast__credit a:hover { text-decoration-color: currentColor; }


@container (max-width: 40rem) {
  .client__in { font-size: calc(100cqi / 48); padding: 1.2em; }
  .inv, .inbox__list { display: none; }
  .app--replies .ui { font-size: calc(100cqi / 48); }
  .inbox { grid-template-columns: minmax(0, 1fr); }
  .thread { padding: 2em; }
}

@container (max-width: 30rem) {
  .ui { font-size: calc(100cqi / 40); }
  .ui__input, .ui__chip:nth-child(2), .ui__owed, .chase__note, .chase__status:nth-child(1) { display: none; }
  .ledger__row { grid-template-columns: minmax(0, 1fr) auto auto; }
  .ledger__row > :nth-child(1), .ledger__row > :nth-child(3), .ledger__row:nth-child(n+8) { display: none; }
  .chase { flex-wrap: wrap; row-gap: 0.6em; }
}
@media (max-width: 40rem) { .app--hero { aspect-ratio: 4 / 5; } .app--replies { aspect-ratio: 1 / 1; } .client { aspect-ratio: 5 / 7; } .hang { margin-left: -0.3em; } .life li { grid-template-columns: minmax(0, 1fr) auto; row-gap: var(--space-2xs); padding-block: var(--space-md); } .life__date { grid-column: 1 / -1; } }

@media (max-width: 60rem) {
  .hero { min-height: 0; padding-block: var(--space-xl) var(--space-3xl); }
  .hero__grid { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-xl); }
  .split, .rows, .band__grid { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-xl); }
  .split > *, .rows > *, .band__grid > *, .split--work .split__text, .split--work .photo, .split--replies .app--replies, .split--replies .split__text, .rows__head, .life, .band__text, .signup { grid-column: 1 / -1; }
  .split--replies .split__text { order: -1; }
  .life li { min-height: 72px; }
}
</style>
</head>
