/* object-through-giant-type - at rest: the quote in capitals, in ink, with the object's still standing
   above it and the credit under. Live: the wall of capitals filling the held stage, the object on its
   own layer falling through it (the render draws over its still while the scene is near). */
[data-big-scene="object-through-giant-type"] { background: var(--bg); color: var(--ink); --ott-obj: min(44svh, 34vw); --ott-size: clamp(34px, 6.6vw, 104px); --ott-gap: .62; }
[data-big-scene="object-through-giant-type"] .ott__quote { margin: 0; }
[data-big-scene="object-through-giant-type"] .ott__line {
  margin: 0; display: flex; justify-content: center; gap: 0.26em; white-space: nowrap;
  font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: -0.01em; text-transform: uppercase;
  font-size: var(--ott-size); line-height: 0.98;
  color: color-mix(in oklab, var(--ink) calc(var(--k, 1) * 100%), var(--muted) );
}
[data-big-scene="object-through-giant-type"] .ott__half { display: inline-block; will-change: transform; }
[data-big-scene="object-through-giant-type"] .ott__object { position: relative; }
[data-big-scene="object-through-giant-type"] .ott__still, [data-big-scene="object-through-giant-type"] .ott__img { display: block; width: 100%; aspect-ratio: 1; object-fit: contain; }
