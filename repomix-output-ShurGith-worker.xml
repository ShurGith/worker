/* parts-lock-into-the-whole - at rest: the heading and spec list beside the finished screen. Live:
   the screen centred on the held stage, its panels flown in by transform; the word huge at the
   centre until it steps into its place; the spec beside the screen at the end. */
[data-big-scene="parts-lock-into-the-whole"] { background: var(--bg); color: var(--ink); --pl-ui-w: 880px; }
[data-big-scene="parts-lock-into-the-whole"] > .sc__stage { width: 100%; max-width: calc(var(--container) + 2 * var(--pad)); margin-inline: auto; padding: var(--section) var(--pad); }
[data-big-scene="parts-lock-into-the-whole"] .pl__ui {
  display: grid; grid-template-columns: 180px minmax(0, 1fr) 200px; grid-template-rows: 44px minmax(0, 1fr); grid-template-areas: "bar bar bar" "side main insp";
  gap: 1px; width: 100%; max-width: var(--pl-ui-w); margin-inline: auto; aspect-ratio: 16 / 10;
  --pl-box: 1;
  background: color-mix(in oklab, var(--line) calc(var(--pl-box) * 100%), transparent); border: 1px solid color-mix(in oklab, var(--line) calc(var(--pl-box) * 100%), transparent); border-radius: var(--r-md); overflow: clip;
  font-family: var(--font-text); font-size: 13px; line-height: 1.4; color: var(--ink);
  box-shadow: 0 1px 2px color-mix(in oklab, var(--ink) calc(var(--pl-box) * 6%), transparent), 0 16px 40px -20px color-mix(in oklab, var(--ink) calc(var(--pl-box) * 30%), transparent);
}
[data-big-scene="parts-lock-into-the-whole"] .pl__panel { background: var(--card, var(--surface)); min-width: 0; overflow: clip; }
[data-big-scene="parts-lock-into-the-whole"] .pl__bar { grid-area: bar; }
[data-big-scene="parts-lock-into-the-whole"] .pl__side { grid-area: side; }
[data-big-scene="parts-lock-into-the-whole"] .pl__main { grid-area: main; }
[data-big-scene="parts-lock-into-the-whole"] .pl__insp { grid-area: insp; }
[data-big-scene="parts-lock-into-the-whole"] .pl__word { display: none; }
[data-big-scene="parts-lock-into-the-whole"] .pl__spec h2 { max-width: 16ch; }
[data-big-scene="parts-lock-into-the-whole"] .pl__spec dl { margin: var(--s-6) 0 0; border-top: 1px solid var(--line); max-width: 420px; }
[data-big-scene="parts-lock-into-the-whole"] .pl__spec dl > div { display: flex; justify-content: space-between; gap: var(--s-5); padding-block: var(--s-3); border-bottom: 1px solid var(--line); }
[data-big-scene="parts-lock-into-the-whole"] .pl__spec dt { color: var(--muted); }
[data-big-scene="parts-lock-into-the-whole"] .pl__spec dd { text-align: right; }
[data-big-scene="parts-lock-into-the-whole"] [data-ink="x"] { transform-origin: 0 50%; }
