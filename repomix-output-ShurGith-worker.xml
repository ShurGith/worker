        }
      });
      scout.observe(document.body, { childList: true, subtree: true });
    }

    enterPickingIfArmed();
    syncPageInteractionCursor();
    syncPageChatFocus('init-complete');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
