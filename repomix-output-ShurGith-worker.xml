  --p-inv-bg: #f2f2f0; --p-inv-surface: #e6e6e3; --p-inv-ink: #0c0d0f; --p-inv-muted: #5b5e62;
  --p-inv-accent: #2f6fd6; --p-inv-accent-ink: #ffffff; --p-inv-action: #0c0d0f; --p-inv-action-ink: #f2f2f0;
