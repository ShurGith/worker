  const props = /^(padding|margin|gap|row-gap|column-gap)(-[a-z]+)?$/;
  const counts = new Map();
  for (const r of ctx.rules) {
    if (r.keyframes || isTokenRule(r)) continue;
    for (const d of r.decls) {
