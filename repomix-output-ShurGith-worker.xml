  .index a span { font: 500 13px/1 var(--font-mono); color: var(--muted); }
  .index a svg { width: 16px; height: 16px; transition: transform 260ms var(--ease); }
  .index a:hover svg { transform: translateX(4px); }
  .hero__pics { grid-column: 7 / span 6; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; height: min(70svh, 660px); min-height: 440px; }
  .pic { position: relative; overflow: clip; border-radius: 20px; border: 1px solid var(--line); isolation: isolate; }
  .pic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 42%; display: block; }
  .pic--down { margin-top: 48px; }

  /* ------------------------------------------------ an object, one screen */
  .obj { min-height: calc(100svh - 64px); display: grid; align-content: center; padding: 64px 0; border-top: 1px solid var(--line); }
  .obj__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; align-items: end; margin-bottom: 32px; }
  .obj__title { grid-column: 1 / span 5; }
  .obj__n { margin: 0 0 14px; font: 500 13px/1 var(--font-mono); color: var(--muted); display: flex; gap: 10px; align-items: center; }
  .obj__n b { color: var(--ink); font-weight: 500; }
