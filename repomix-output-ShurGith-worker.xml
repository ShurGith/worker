        const merged = { ...made, variants: { ...keep, ...made.variants } };
        fs.writeFileSync(mf, JSON.stringify(merged, null, 1) + '\n');
        console.log(`  wrote ${path.relative(dir, mf)} (${Object.keys(merged.variants).length} variants)`);
