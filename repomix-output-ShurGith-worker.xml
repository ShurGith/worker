   screen. Live: the same split on the held stage; the rows arrive and fold by transform; the box
   behind the screen is clipped to the rows it holds and closes round the action at the end. */
[data-big-scene="product-assembles-into-its-action"] { background: var(--bg); color: var(--ink); --pa-screen-w: 560px; }
[data-big-scene="product-assembles-into-its-action"] > .sc__stage {
  display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: center;
  width: 100%; max-width: calc(var(--container) + 2 * var(--pad)); margin-inline: auto; padding: var(--section) var(--pad);
