    .pic { aspect-ratio: 3 / 4; }
    .obj__title, .obj__about { grid-column: 1 / -1; }
    .duo { height: auto; grid-template-columns: minmax(0, 1fr); }
    .big, .duo .card, .obj:nth-of-type(even) .big, .obj:nth-of-type(even) .duo .card { grid-column: 1 / -1; grid-row: auto; }
