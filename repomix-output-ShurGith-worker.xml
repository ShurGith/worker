.ui-voice__wave { flex: 1; display: flex; align-items: center; justify-content: center; gap: 3px; height: 24px; min-width: 0; overflow: hidden; }
.ui-voice__wave i { flex: none; width: 2px; height: calc(var(--h, 6) * 1px); border-radius: 1px; background: color-mix(in oklab, var(--u-ink) 55%, var(--u-bg)); transform-origin: 50% 50%; transition: background-color 200ms var(--u-ease); }
.ui-voice.is-talking .ui-voice__wave i { background: var(--u-ink); animation: ui-wave 820ms var(--u-ease) infinite alternate; }
.ui-voice.is-talking .ui-voice__wave i:nth-child(3n) { animation-duration: 640ms; }
.ui-voice.is-talking .ui-voice__wave i:nth-child(3n + 1) { animation-duration: 1040ms; }
.ui-voice.is-talking .ui-voice__wave i:nth-child(4n) { animation-delay: -300ms; }
.ui-voice.is-talking .ui-voice__wave i:nth-child(5n) { animation-delay: -560ms; }
@keyframes ui-wave { from { transform: scaleY(0.35); } to { transform: scaleY(1.15); } }
@media (max-width: 300px) { .ui-voice__wave i:nth-child(n + 19) { display: none; } }
