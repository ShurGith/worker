            <div class="stage stage--fade-b"><div class="at-corner fit" style="--ax:24px;--ay:28px;--fit-max:456px" data-ui-load="window" data-ui-opts='{"compact":true}'></div></div>
          </div>
        </div>
      </article>
      <article class="card card--row">
        <h3>Hands off when it should</h3>
        <p>Refunds over your limit or an upset customer go straight to a person, with the full history.</p>
        <div class="panel" data-fx="gradient-mesh" data-fx-seed="14" data-fx-palette='{"bg":"#c6d3df","surface":"#d6e0e9","ink":"#25303a","muted":"#5d6873","accent":"#3f6a92"}' data-fx-params='{"speed":0,"calm":0.15,"calmX":0.4,"calmY":0.95,"tint":0.6,"relief":0.35}' style="--calm-k:0%">
