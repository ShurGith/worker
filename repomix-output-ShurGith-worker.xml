  function describeAgentTargetCandidate(el) {
    return {
      tag: el.tagName.toLowerCase(),
      id: el.id || null,
      classes: [...el.classList].filter((c) => !c.startsWith('impeccable-')),
      text: (el.textContent || '').trim().slice(0, 80),
    };
  }

