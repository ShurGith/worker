/* dot-becomes-the-full-stop - at rest: the claim at display size with the line under it. Live: the
   claim fitted to one row on the held stage, grown word by word out of the dot. */
[data-big-scene="dot-becomes-the-full-stop"] { background: var(--bg); color: var(--ink); }
[data-big-scene="dot-becomes-the-full-stop"].is-cut { background: var(--p-inv-bg); color: var(--p-inv-ink); --muted: var(--p-inv-muted); }
[data-big-scene="dot-becomes-the-full-stop"] > .sc__stage { width: 100%; max-width: calc(var(--container) + 2 * var(--pad)); margin-inline: auto; padding: var(--section) var(--pad); }
[data-big-scene="dot-becomes-the-full-stop"] .dfs__line { font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-tracking); font-size: var(--t-h1); line-height: 1.06; }
