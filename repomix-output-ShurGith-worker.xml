[data-big-scene="product-assembles-into-its-action"] .pa__copy h2 { max-width: 16ch; }
[data-big-scene="product-assembles-into-its-action"] .pa__steps { margin: var(--s-6) 0 0; padding: 0; list-style: none; display: grid; gap: var(--s-3); max-width: 40ch; }
[data-big-scene="product-assembles-into-its-action"] .pa__steps li { font-size: var(--t-lead); line-height: 1.4; color: var(--muted); transition: color 240ms var(--ease); }
[data-big-scene="product-assembles-into-its-action"] .pa__steps li.is-on { color: var(--ink); }
[data-big-scene="product-assembles-into-its-action"]:not(.is-live) .pa__steps li { color: var(--ink); }
