    const us = !nordic && (intl ? c[0] === '1' && /^[2-9]\d{2}55501\d\d$/.test(n) : /^[2-9]\d{2}55501\d\d$/.test(n) || (/^55501\d\d$/.test(n) && /555[.\-]01\d\d/.test(s)));
