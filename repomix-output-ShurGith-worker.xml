  /* ------------------------------------------------ the bar */
  .bar { position: sticky; top: 0; z-index: 30; background: color-mix(in oklab, var(--bg) 84%, transparent); backdrop-filter: blur(16px) saturate(1.2); border-bottom: 1px solid var(--line); }
  .bar__in { height: 64px; display: flex; align-items: center; gap: 32px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 15px; letter-spacing: -0.01em; text-decoration: none; }
  .brand svg { width: 22px; height: 22px; }
  .brand svg .a { fill: var(--accent); transition: transform 420ms var(--ease); transform-origin: 11px 11px; }
  .brand:hover svg .a { transform: rotate(90deg); }
  .nav { display: flex; gap: 24px; font-size: 14px; }
