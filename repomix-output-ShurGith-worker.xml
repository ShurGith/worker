<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Icons demo</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../system.css">
<link rel="stylesheet" href="icon.css">
<style>
  :root { --font-display: "Inter", system-ui, sans-serif; --font-text: "Inter", system-ui, sans-serif; --display-weight: 500; }
  .demo-head { display: grid; gap: 12px; margin-bottom: var(--head-gap); }
  .demo-head h2 { max-width: 20ch; }
  .demo-h { font: 500 var(--t-card)/1.3 var(--font-text); letter-spacing: -0.01em; margin: 40px 0 16px; }
  .demo-h:first-child { margin-top: 0; }
  .demo-h .muted { font-size: var(--t-small, 14px); font-weight: 400; margin-left: 6px; }
  .demo-split { display: grid; gap: 48px; margin-top: 64px; }
  .demo-line { display: flex; flex-wrap: wrap; align-items: center; gap: 24px 20px; }
  .demo-glyphs { display: grid; grid-template-columns: repeat(auto-fill, 40px); gap: 8px; }
  .demo-chips { gap: 8px; }
  .demo-files { display: grid; gap: 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 1024px) { .demo-split { grid-template-columns: 1fr 1fr; gap: 64px; } .demo-files--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 479px) { .demo-files { grid-template-columns: 1fr; } }
</style>
</head>
<body>

<section class="section ground-base">
 <div class="container">
