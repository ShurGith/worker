nk","bg":"#f8f8f8","surface":"#eeeeee","ink":"#0a0a0a","muted":"#6a6a6a","accent":"#1f6b3a","accentInk":"#ffffff"},{"id":"swap-pastels","name":"Swapping pastels","bg":"#c3d7e5","surface":"#d0e0eb","ink":"#141414","muted":"#4a5068","accent":"#0f5257","accentInk":"#ffffff"},{"id":"blush-sage-slate","name":"Blush, sage, slate","bg":"#a6b3bc","surface":"#b2bdc5","ink":"#1c1c1c","muted":"#38424a","accent":"#2c3620","accentInk":"#e3e2da"},{"id":"candy-on-black","name":"Candy on black","bg":"#000000","surface":"#0d0d0d","ink":"#ffffff","muted":"#999999","accent":"#93f1f7","accentInk":"#000000"},{"id":"sky-sand","name":"Sky and sand","bg":"#cbe4f2","surface":"#bcdcee","ink":"#0a0a0a","muted":"#44606e","accent":"#b0298f","accentInk":"#ffffff"},{"id":"studio-grey","name":"Studio grey","bg":"#a8a8aa","surface":"#b4b4b6","ink":"#0e0e0e","muted":"#3a3a3c","accent":"#1f5c49","accentInk":"#ffffff"},{"id":"walnut-tan","name":"Walnut and tan","bg":"#2b2216","surface":"#382d1e","ink":"#e4e2da","muted":"#a39a8b","accent":"#bda38b","accentInk":"#2b2216"}]</script>
<script id="presets" type="application/json">{"light":"moss-sand","dark":"blue-black-cornflower","colour":"cobalt-field"}</script>
<script type="module">
  const $ = s => document.querySelector(s);
  const PATHS = JSON.parse($('#paths').textContent);
  const PALETTES = JSON.parse($('#palettes').textContent);
  const PRESETS = JSON.parse($('#presets').textContent);
  const byId = Object.fromEntries(PALETTES.map(p => [p.id, p]));
  const q = new URLSearchParams(location.search);

  const [{ default: fx }, { pick }] = await Promise.all([import(PATHS.fx + 'fx.js'), import(PATHS.fx + 'pick.js')]);
  const ui = await import(PATHS.ui + 'ui.js').then(m => m.default).catch(() => null);

  $('#lab').href = PATHS.fx + 'lab.html';
  if (q.has('fallback')) fx.config.forceFallback = true;
  if (q.has('webgl1')) fx.config.forceWebGL1 = true;
  if (q.has('time')) fx.setClock(+q.get('time'));

  const FAMILIES = { grain: 'Grain', dither: 'Dither', mesh: 'Mesh', light: 'Light', liquid: 'Liquid', pattern: 'Pattern', material: 'Material', photo: 'Photo' };
  const ORDER = Object.keys(FAMILIES);
  const SLOT_WORDS = { hero: 'hero frames', card: 'cards', band: 'bands', footer: 'footers' };
  const SLOT_ORDER = ['hero', 'card', 'band', 'footer'];
  const KIND_WORDS = { light: 'light', dark: 'dark', colour: 'colour' };
  // seeds that show each effect well in the grid; New seed on a tile deals another
  const SEEDS = {};
  const famName = f => FAMILIES[f] || f[0].toUpperCase() + f.slice(1);
  const andList = a => (a.length < 2 ? a.join('') : `${a.slice(0, -1).join(', ')} and ${a[a.length - 1]}`);

  const tiles = [];
  const cards = [...document.querySelectorAll('[data-card]')].map(el => ({ el, label: el.parentElement.querySelector('.ground b'), ctrl: null, id: null }));
  const hero = { el: $('#hero'), label: $('#hero-tag b'), ctrl: null, id: null };
  let index = null, palette = null, kind = 'light', paused = false, family = q.get('family') || '';

  /* ---------------------------------------------------------------- palette */
  function initialPalette() {
    const key = q.get('palette');
    if (key) return byId[PRESETS[key] || key] || byId[PRESETS.light];
    const dark = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches;
    return byId[PRESETS[dark ? 'dark' : 'light']] || PALETTES[0];
  }
  // the card, its inset panel and the UI window on it, all from the page palette
  function derived(p, k) {
    const c = fx.color;
    if (k === 'light') return { card: c.mix(p.bg, p.ink, 0.045), panel: c.mix(p.surface, p.ink, 0.06), win: c.mix(p.bg, '#ffffff', 0.55), winSurface: c.mix(p.bg, '#ffffff', 0.25) };
    if (k === 'dark') return { card: c.mix(p.bg, p.ink, 0.05), panel: p.bg, win: c.mix(p.surface, p.ink, 0.07), winSurface: c.mix(p.surface, p.ink, 0.12) };
    return { card: c.mix(p.bg, p.ink, 0.07), panel: p.bg, win: c.mix(p.surface, p.ink, 0.12), winSurface: c.mix(p.surface, p.ink, 0.18) };
  }
  const cardPalette = () => { const d = derived(palette, kind); return fx.normalizePalette({ ...palette, bg: d.panel, surface: d.card }); };

  function applyVars() {
    const r = document.documentElement;
    const d = derived(palette, kind);
    const vars = { bg: palette.bg, surface: palette.surface, ink: palette.ink, muted: palette.muted, accent: palette.accent, 'accent-ink': palette.accentInk,
      card: d.card, panel: d.panel, win: d.win, 'win-surface': d.winSurface };
    for (const [k, v] of Object.entries(vars)) r.style.setProperty('--' + k, v);
    r.dataset.theme = kind === 'light' ? 'light' : 'dark';
    r.style.colorScheme = kind === 'light' ? 'light' : 'dark';
    for (const b of document.querySelectorAll('.seg button')) b.setAttribute('aria-pressed', String(b.dataset.kind === kind));
    $('#pal').value = palette.id;
  }

  // a controller may come back as a promise when the effect remounts to change colour
  function hold(holder, result) {
    if (result && typeof result.then === 'function') result.then(c => { holder.ctrl = c; if (paused) c.pause(); });
  }

  function setPalette(p) {
    const before = kind;
    palette = p;
    kind = fx.paletteKind(p);
    applyVars();
    if (kind !== before) order();
    const pal = fx.normalizePalette(p);
    for (const t of tiles) {
      fitBadge(t);
      if (t.ctrl) hold(t, t.ctrl.setPalette(pal));
    }
    if (kind !== before) deal();
    else {
      if (hero.ctrl) hold(hero, hero.ctrl.setPalette(pal));
      for (const c of cards) if (c.ctrl) hold(c, c.ctrl.setPalette(cardPalette()));
    }
    syncUrl();
  }

  /* ---------------------------------------------------------------- tiles */
  function fitBadge(t) {
    const fits = t.meta.palettes.includes(kind);
    t.badge.hidden = fits;
    if (!fits) t.badge.querySelector('.tag').textContent = `Made for ${andList(t.meta.palettes.map(k => KIND_WORDS[k]))} pages`;
  }
  function snippet(t) {
    return `<div data-fx="${t.meta.id}" data-fx-seed="${t.seed}"></div>`;
  }
  function buildTile(meta) {
    const el = document.createElement('article');
    el.className = 'tile';
    el.dataset.id = meta.id;
    el.dataset.family = meta.family;
    el.innerHTML = `
      <div class="stage"><div class="badge" hidden><span class="tag"></span></div></div>
      <div class="info">
        <div class="info-top"><h3></h3><span class="fam"></span></div>
        <p class="look"></p>
        <div class="info-foot"><p class="for"></p><div class="links"><button type="button" data-act="seed">New seed</button><button type="button" data-act="copy">Copy code</button></div></div>
      </div>`;
    el.querySelector('h3').textContent = meta.name;
    el.querySelector('.fam').textContent = famName(meta.family);
    el.querySelector('.look').textContent = meta.look;
    const slots = SLOT_ORDER.filter(s => meta.bestOn.includes(s)).map(s => SLOT_WORDS[s]);
    // an effect with "random": false is a literal subject: the random pick never deals it
    el.querySelector('.for').textContent = `For ${andList(slots)}${meta.motion === 'still' ? ', still' : ''}${meta.random === false ? '. Chosen on purpose, never dealt' : ''}`;
    const t = { meta, el, stage: el.querySelector('.stage'), badge: el.querySelector('.badge'), seed: SEEDS[meta.id] ?? 100 + fx.hashSeed(meta.id) % 900, ctrl: null };
    el.querySelector('[data-act="seed"]').addEventListener('click', () => { t.seed = Math.floor(Math.random() * 10000); mountTile(t); });
    el.querySelector('[data-act="copy"]').addEventListener('click', async () => {
      const code = snippet(t);
      try { await navigator.clipboard.writeText(code); toast('Copied ' + code); }
      catch (_) { toast(code, 4000); }
    });
    return t;
  }
  async function mountTile(t) {
    try {
      t.ctrl = await fx.mount(t.stage, t.meta.id, { palette: fx.normalizePalette(palette), seed: t.seed });
      if (paused) t.ctrl.pause();
    } catch (err) { console.warn(`${t.meta.id}:`, err); }
  }

  function buildFilters() {
    const box = $('#filters');
    const counts = {};
    for (const e of index.effects) counts[e.family] = (counts[e.family] || 0) + 1;
    const fams = [...ORDER.filter(f => counts[f]), ...Object.keys(counts).filter(f => !ORDER.includes(f))];
    const make = (key, label, n) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.dataset.family = key;
      b.innerHTML = '<b></b><span></span>';
      b.querySelector('b').textContent = label;
      b.querySelector('span').textContent = n;
      b.addEventListener('click', () => { family = key; filter(); syncUrl(); });
      box.append(b);
    };
    make('', 'All', index.effects.length);
    for (const f of fams) make(f, famName(f), counts[f]);
  }
  // effects made for this palette kind first, in family order; the others after them
  function order() {
    const grid = $('#grid');
    const fits = t => t.meta.palettes.includes(kind);
    for (const t of [...tiles.filter(fits), ...tiles.filter(t => !fits(t))]) grid.append(t.el);
  }
  function filter() {
    if (family && !tiles.some(t => t.meta.family === family)) family = '';
    for (const t of tiles) t.el.hidden = !!family && t.meta.family !== family;
    for (const b of document.querySelectorAll('#filters button')) b.setAttribute('aria-pressed', String(b.dataset.family === family));
  }

  /* ---------------------------------------------------------------- random pick */
  const HISTORY_KEY = 'fx-gallery-history';
  function readHistory() {
    try { const h = JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]'); return Array.isArray(h) ? h : []; } catch (_) { return []; }
  }
  function writeHistory(h) {
    try { localStorage.setItem(HISTORY_KEY, JSON.stringify(h.slice(-100))); } catch (_) { /* no storage: picks are still spread within a deal */ }
  }
  let dealSeed = q.get('deal') || null;
  async function deal(seed) {
    const history = readHistory();
    let dealt;
    try {
      // a seed from the address deals the same set every time, so it ignores this browser's history
      dealt = pick(index.effects, { palette: kind, slots: ['hero', 'card', 'card', 'card', 'card'], history: seed == null ? history : [], seed: seed ?? undefined });
    } catch (err) { toast(err.message); return; }
    if (seed == null) writeHistory([...history, ...dealt.picks.map(p => p.id)]);
    dealSeed = dealt.seed;
    const n = fx.hashSeed(dealt.seed);
    const [h, ...rest] = dealt.picks;
    const jobs = [];
    hero.id = h.id;
    hero.label.textContent = nameOf(h.id);
    // the effect keeps the area under the hero's text calm
    const fr = hero.el.getBoundingClientRect(), tr = hero.el.querySelector('.hero-copy h1').getBoundingClientRect();
    const tp = hero.el.querySelector('.hero-copy p').getBoundingClientRect();
    const calm = fr.width ? { calmX: Math.min(0.8, Math.max(0.15, (tr.left + Math.min(tr.width, tp.width) * 0.42 - fr.left) / fr.width)), calmY: Math.min(0.85, Math.max(0.3, ((tr.top + tp.bottom) / 2 - fr.top) / fr.height)) } : { calmX: 0.24, calmY: 0.7 };
    jobs.push(fx.mount(hero.el, h.id, { palette: fx.normalizePalette(palette), seed: n, params: calm }).then(c => { hero.ctrl = c; if (paused) c.pause(); }));
    rest.forEach((p, i) => {
      const c = cards[i];
      c.id = p.id;
      c.label.textContent = nameOf(p.id);
      jobs.push(fx.mount(c.el, p.id, { palette: cardPalette(), seed: n + 17 * (i + 1) }).then(ctrl => { c.ctrl = ctrl; if (paused) ctrl.pause(); }));
    });
    await Promise.all(jobs.map(j => j.catch(err => console.warn(err))));
    syncUrl();
    return dealt;
  }
  const nameOf = id => (index.effects.find(e => e.id === id) || { name: id }).name;

  /* ---------------------------------------------------------------- controls */
  function toast(msg, ms = 1800) {
    const el = $('#toast');
    el.textContent = msg;
    el.classList.add('on');
    clearTimeout(toast.t);
    toast.t = setTimeout(() => el.classList.remove('on'), ms);
  }
  function syncUrl() {
    try {
      const u = new URL(location.href);
      u.searchParams.set('palette', palette.id);
      if (family) u.searchParams.set('family', family); else u.searchParams.delete('family');
      if (dealSeed) u.searchParams.set('deal', dealSeed);
      history.replaceState(null, '', u);
    } catch (_) { /* a sandboxed frame may refuse; the page works without it */ }
  }
  for (const b of document.querySelectorAll('.seg button')) b.addEventListener('click', () => setPalette(byId[PRESETS[b.dataset.kind]]));
  const sel = $('#pal');
  const groups = { light: [], dark: [], colour: [] };
  for (const p of PALETTES) groups[fx.paletteKind(p)].push(p);
  for (const [k, list] of Object.entries(groups)) {
    const og = document.createElement('optgroup');
    og.label = k[0].toUpperCase() + k.slice(1);
    for (const p of list) og.append(new Option(p.name, p.id));
    sel.append(og);
  }
  sel.addEventListener('change', () => setPalette(byId[sel.value]));
  $('#pause').addEventListener('click', e => {
    paused = !paused;
    e.currentTarget.textContent = paused ? 'Play' : 'Pause';
    e.currentTarget.setAttribute('aria-pressed', String(paused));
    for (const h of [...tiles, hero, ...cards]) if (h.ctrl) paused ? h.ctrl.pause() : h.ctrl.resume();
  });
  $('#deal').addEventListener('click', async () => {
    const d = await deal();
    if (d) toast(`Dealt: ${d.picks.map(p => nameOf(p.id)).join(', ')}`, 2600);
  });

  /* ---------------------------------------------------------------- load */
  palette = initialPalette();
  kind = fx.paletteKind(palette);
  applyVars();
  try {
    index = await fetch(PATHS.fx + 'index.json', { cache: 'no-store' }).then(r => { if (!r.ok) throw new Error(r.status); return r.json(); });
  } catch (err) {
    $('#grid').innerHTML = '<p class="empty">The effects index did not load. Serve this folder over http (node scripts/effects.mjs serve) and run node scripts/effects.mjs index.</p>';
    throw err;
  }
  const famCount = new Set(index.effects.map(e => e.family)).size;
  $('#count').textContent = `${index.effects.length} effects in ${famCount} families`;
  const sorted = [...index.effects].sort((a, b) => (ORDER.indexOf(a.family) + 99 * !ORDER.includes(a.family)) - (ORDER.indexOf(b.family) + 99 * !ORDER.includes(b.family)) || a.name.localeCompare(b.name));
  for (const meta of sorted) { const t = buildTile(meta); tiles.push(t); $('#grid').append(t.el); fitBadge(t); }
  order();
  buildFilters();
  filter();
  if (!ui) document.getElementById('cards').hidden = true;
  await Promise.all([
    ...tiles.map(mountTile),
    deal(dealSeed),
    ui ? ui.loadAll(document).catch(err => console.warn(err)) : null,
  ]);
  document.documentElement.dataset.ready = '1';
</script>
