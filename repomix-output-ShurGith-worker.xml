  .seg button { height: 30px; border: 0; background: transparent; padding: 0 12px; border-radius: 7px; cursor: pointer; color: var(--muted); font-size: 14px; }
  .seg button[aria-pressed="true"] { background: var(--bg); color: var(--ink); box-shadow: 0 0 0 1px var(--line), 0 1px 2px rgb(0 0 0 / 0.08); }
  .btn, .select {
    height: 36px; padding: 0 14px; border-radius: 10px; border: 0; background: var(--bg); color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line-2); cursor: pointer; display: inline-flex; align-items: center; gap: 8px;
    font-size: 14px; font-weight: 500; white-space: nowrap;
  }
  .btn:hover, .select:hover { box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--ink) 38%, transparent); }
  .btn--primary { background: var(--accent); color: var(--accent-ink); box-shadow: none; }
  .btn--primary:hover { box-shadow: none; background: color-mix(in oklab, var(--accent) 88%, var(--ink)); }
  .btn svg { width: 16px; height: 16px; flex: none; }
  .select { max-width: 220px; padding-right: 10px; }

  /* hero: a dealt hero effect with text in its calm area */
  .hero { position: relative; margin-top: 24px; height: clamp(480px, 68vh, 660px); border-radius: 20px; overflow: hidden;
    display: flex; flex-direction: column; justify-content: flex-end; }
  .hero::after, .stage::after, .panel::after { content: ""; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px var(--line); pointer-events: none; z-index: 2; }
  .hero-copy { position: relative; z-index: 1; padding: 56px; max-width: 760px; }
  .hero h1 { max-width: 9.5em; margin: 0 0 18px; font-size: clamp(38px, 3.4vw + 10px, 62px); line-height: 1.02; letter-spacing: -0.035em; font-weight: 520; text-wrap: balance; }
  .hero p { margin: 0; max-width: 44ch; font-size: 18px; line-height: 28px; color: var(--muted); text-wrap: pretty; }
  .hero-tag { position: absolute; right: 20px; bottom: 20px; z-index: 3; }
  .tag { display: inline-flex; align-items: center; gap: 8px; height: 30px; padding: 0 12px; border-radius: 999px; font-size: 13px;
    background: color-mix(in oklab, var(--bg) 82%, transparent); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); white-space: nowrap; }
  .tag span { color: var(--muted); }

  /* sections */
  section { padding-top: 96px; }
  .sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px 48px; flex-wrap: wrap; margin-bottom: 32px; }
  .sec-head h2 { margin: 0 0 10px; font-size: clamp(28px, 1.2vw + 18px, 36px); line-height: 1.1; letter-spacing: -0.025em; font-weight: 520; }
  .sec-head p { margin: 0; color: var(--muted); max-width: 56ch; font-size: 16px; line-height: 24px; text-wrap: pretty; }
  .filters { display: flex; flex-wrap: wrap; gap: 6px; }
  .filters button { height: 32px; padding: 0 12px; border-radius: 999px; border: 0; cursor: pointer; font-size: 14px; color: var(--muted);
    background: transparent; box-shadow: inset 0 0 0 1px var(--line); }
  .filters button b { font-weight: 500; }
  .filters button span { margin-left: 6px; font-variant-numeric: tabular-nums; opacity: 0.75; }
  .filters button[aria-pressed="true"] { background: var(--ink); color: var(--bg); box-shadow: none; }

  /* the grid of every effect: one size of tile, labels under the picture */
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px 24px; }
  .tile { min-width: 0; display: flex; flex-direction: column; }
  .tile[hidden] { display: none; }
  .stage { position: relative; aspect-ratio: 3 / 2; border-radius: 14px; overflow: hidden; background: var(--bg); }
  .badge { position: absolute; top: 12px; left: 12px; z-index: 3; }
  .info { padding: 16px 2px 0; display: grid; gap: 6px; }
  .info-top { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .info h3 { margin: 0; font-size: 17px; line-height: 24px; font-weight: 560; letter-spacing: -0.01em; }
  .fam { flex: none; font-size: 14px; color: var(--muted); }
  .look { margin: 0; color: var(--muted); font-size: 14px; line-height: 21px; max-width: 62ch; min-height: 42px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .info-foot { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 2px; }
  .for { margin: 0; font-size: 14px; line-height: 20px; }
  .links { flex: none; display: flex; gap: 16px; }
  .links button { border: 0; background: none; padding: 4px 0; cursor: pointer; font-size: 14px; color: var(--muted);
    text-decoration: underline; text-decoration-color: var(--line-2); text-underline-offset: 4px; }
  .links button:hover { color: var(--ink); text-decoration-color: currentColor; }

  /* feature cards: an effect ground in the inset panel and a UI fragment on top */
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .card { background: var(--card); border-radius: 18px; padding: 28px 28px 24px; box-shadow: inset 0 0 0 1px var(--line); display: flex; flex-direction: column; min-width: 0; }
  .card h3 { margin: 0 0 8px; font-size: 18px; line-height: 24px; font-weight: 560; letter-spacing: -0.01em; }
  .card > p:not(.ground) { margin: 0; color: var(--muted); font-size: 15px; line-height: 24px; max-width: 44ch; min-height: 48px; text-wrap: pretty; }
  .panel { position: relative; margin-top: 24px; height: 380px; border-radius: 12px; overflow: hidden; display: grid; place-items: center; padding: 32px; }
  .panel--bleed { place-items: end center; padding-bottom: 0; }
  .panel--bleed > .slot { margin-bottom: -48px; }
  .slot { position: relative; z-index: 1; max-width: 100%;
    --ui-font: var(--font); --ui-mono: var(--mono); --ui-radius: 12px;
    --fx-bg: var(--win); --fx-surface: var(--win-surface); --fx-ink: var(--ink); --fx-muted: var(--muted);
    --fx-accent: var(--accent); --fx-accent-ink: var(--accent-ink); }
  .ground { margin: 14px 2px 0; font-size: 13px; line-height: 20px; color: var(--muted); }
  .ground b { font-weight: 500; color: var(--ink); }

  .foot { padding-top: 96px; padding-bottom: 48px; }
  .foot-in > div { border-top: 1px solid var(--line); padding-top: 24px; display: flex; justify-content: space-between; gap: 16px 48px; flex-wrap: wrap; color: var(--muted); font-size: 14px; }
  .foot-in p { margin: 0; max-width: 72ch; }
  .foot a { color: var(--ink); text-underline-offset: 4px; text-decoration-color: var(--line-2); }
  .empty { padding: 64px 0; color: var(--muted); }

  .toast { position: fixed; left: 50%; bottom: 24px; z-index: 60; transform: translate(-50%, 16px); opacity: 0; pointer-events: none;
    max-width: calc(100vw - 32px); padding: 10px 16px; border-radius: 12px; background: var(--ink); color: var(--bg); font-size: 14px;
    transition: opacity .2s ease, transform .2s ease; }
  .toast.on { opacity: 1; transform: translate(-50%, 0); }

  @media (max-width: 1080px) {
    .hero-copy { padding: 40px; }
  }
  @media (max-width: 860px) {
    .grid, .cards { grid-template-columns: minmax(0, 1fr); }
    .grid { gap: 40px; }
  }
  @media (max-width: 720px) {
    :root { --gut: 16px; }
    .top { position: static; }
    .brand span, .select { display: none; }
    .top-in { display: grid; grid-template-columns: 1fr auto; grid-template-areas: "brand deal" "controls controls"; }
    .brand { grid-area: brand; }
    #deal { grid-area: deal; }
    .top-in .controls { grid-area: controls; margin-left: 0; flex-wrap: nowrap; }
    .seg { flex: 1; }
    .seg button { flex: 1; }
    .hero { margin-top: 16px; height: 560px; border-radius: 16px; }
    .hero-copy { padding: 28px 24px 72px; }
    .hero p { font-size: 16px; line-height: 24px; }
    .hero-tag { left: 24px; right: auto; bottom: 20px; }
    section { padding-top: 72px; }
    .card { padding: 20px; }
    .panel { height: 340px; padding: 20px 16px; }
    .info-foot { flex-wrap: wrap; }
  }
</style>
</head>
