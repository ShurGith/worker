.hero__window { background:
  radial-gradient(120% 60% at 70% 118%, #6f7f3a 0 40%, transparent 41%),
  radial-gradient(90% 50% at 10% 108%, #57703f 0 42%, transparent 43%),
  radial-gradient(80% 40% at 60% 92%, #9fb2c4 0 40%, transparent 41%),
