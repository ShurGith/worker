<file path=".agents/skills/design-taste-frontend/assets/moments/marquee-row/moment.css">
/* marquee-row: the rail holds the track and its copy, moving left by one track width in a linear
   loop, and fades into the ground at both edges; the pause button sits outside the mask at the
   right. At rest the items wrap into a plain row. */
.mo-mq { --mo-gap: 64px; --mo-dur: 40s; --mo-w: 1000px; position: relative; padding-block: var(--s-4); }
.mo-mq .mo-mq__rail { display: flex; gap: var(--mo-gap); overflow: hidden; padding-right: 56px;
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
.mo-mq .mo-mq__track { display: flex; align-items: center; gap: var(--mo-gap); flex: none; margin: 0; padding: 0; list-style: none; white-space: nowrap;
  font: 500 var(--t-lead)/1 var(--font-display); letter-spacing: -0.01em; color: var(--muted); }
.mo-mq .mo-mq__track img { height: 28px; width: auto; opacity: .8; }
.mo-mq.is-live .mo-mq__track { animation: mo-mq var(--mo-dur) linear infinite; animation-play-state: paused; will-change: transform; }
.mo-mq.is-live.is-on:not(.is-paused) .mo-mq__track { animation-play-state: running; }
.mo-mq.is-live:hover .mo-mq__track { animation-play-state: paused; }
@keyframes mo-mq { to { transform: translateX(calc(-1 * var(--mo-w) - var(--mo-gap))); } }
.mo-mq:not(.is-live) .mo-mq__track { flex-wrap: wrap; white-space: normal; row-gap: var(--s-3); }
.mo-mq .mo-mq__pause { right: 0; bottom: auto; top: 50%; transform: translateY(-50%); }
@media (prefers-reduced-motion: reduce) {
  .mo-mq .mo-mq__track { animation: none !important; }
  /* a preference that changed after the loop was built: no rail to clip, no copy, a wrapped row */
  .mo-mq.is-live .mo-mq__rail { display: block; overflow: visible; padding-right: 0; -webkit-mask-image: none; mask-image: none; }
  .mo-mq.is-live .mo-mq__track { flex-wrap: wrap; white-space: normal; row-gap: var(--s-3); }
  .mo-mq.is-live .mo-mq__clone, .mo-mq.is-live .mo-mq__pause { display: none; }
}
</file>

<file path=".agents/skills/design-taste-frontend/assets/moments/marquee-row/moment.js">
/*
  marquee-row - one row of client words, trades, cities or logos moves slowly sideways in a loop,
  fading out at both edges; it pauses while pointed at, runs only while on screen, and carries a
  pause button (it runs on its own for longer than 5 s). Under reduced motion and without script the
  words stand in a wrapped row.

    <div data-moment="marquee-row" data-moment-opts='{"speed": 36}'>
      <ul class="mo-mq__track"><li>Studios</li><li>Agencies</li>…</ul>      6 to 14 items; logos as <img>
    </div>

  opts: speed px/s (36, 16-80), gap px between items (64).
*/
export default function (root, opts, lib) {
  const track = root.querySelector('.mo-mq__track') || root.firstElementChild;
  if (!track) return {};
  root.classList.add('mo-mq');
  root.style.setProperty('--mo-gap', `${Math.max(24, +opts.gap || 64)}px`);
  if (lib.reduced() || track.children.length < 2) { root.classList.add('is-still'); return {}; }
  const speed = lib.clamp(+opts.speed || 36, 16, 80);
  const clone = track.cloneNode(true);
  clone.setAttribute('aria-hidden', 'true');
  clone.classList.add('mo-mq__clone');
  const rail = document.createElement('div');       // the masked part: the track and its copy
  rail.className = 'mo-mq__rail';
  track.replaceWith(rail);
  rail.append(track, clone);
  const pause = document.createElement('button');
  pause.type = 'button';
  pause.className = 'loop-pause mo-mq__pause';
  const icon = on => `<svg viewBox="0 0 14 14" aria-hidden="true">${on ? '<path d="M3 2h3v10H3zM8 2h3v10H8z"/>' : '<path d="M4 2l8 5-8 5z"/>'}</svg>`;
  const setPaused = p => { root.classList.toggle('is-paused', p); pause.setAttribute('aria-label', p ? 'Play' : 'Pause'); pause.innerHTML = icon(!p); };
  setPaused(false);
  pause.addEventListener('click', () => setPaused(!root.classList.contains('is-paused')));
  root.append(pause);
  root.classList.add('is-live');
  const fit = () => { const w = track.scrollWidth; root.style.setProperty('--mo-w', `${w}px`); root.style.setProperty('--mo-dur', `${(w / speed).toFixed(2)}s`); };
  fit();
  lib.fontsReady().then(fit);
  const ro = new ResizeObserver(fit);
  ro.observe(track);
  const io = new IntersectionObserver(es => root.classList.toggle('is-on', es[es.length - 1].isIntersecting));
  io.observe(root);
  return { destroy() { ro.disconnect(); io.disconnect(); clone.remove(); pause.remove(); rail.replaceWith(track); root.classList.remove('is-live', 'is-on', 'is-paused'); } };
}
</file>

