    deal(null);
    for (const u of uses) { if (u.lazy.started) { useStop(u); useStart(u); } else useMarkup(u); }
    for (const p of photoParts) if (p.ctrl?.setPalette) p.ctrl.setPalette(fx.readPalette(p.frameEl)); else p.lazy.restart();
    if (scene.ctrl?.setPalette) scene.ctrl.setPalette(fx.readPalette(sceneFrame)); else if (scene.lazy?.started) { sceneStop(); sceneStart(); }
    // the objects' grounds and the boxes' grounds are lit palettes of their own: they stay as drawn
    await Promise.all([mountHero(), ui.grounds($('#fx-grid'), fx), ui.grounds(cardlib, fx)]);
    for (const el of $$('[data-ui]', cardlib)) el.__ui?.repaint?.();
    syncUrl();
  }
  for (const b of $$('[data-kinds] button')) b.addEventListener('click', () => setKind(b.dataset.kind));

  /* ---------------------------------------------------------------- start */
  applyKind();
  applyCardTheme();
  orderTiles();
  filterTiles();
  deal(dealSeed);
  glowOnHover();
  await document.fonts?.ready;
  await Promise.all([
    mountHero(),
    ui.loadAll(cardlib).catch(e => console.warn(e)),
    ui.startAll(cardlib),
    ui.grounds($('#fx-grid'), fx),
    ui.grounds(cardlib, fx),
    ui.grounds($('#things'), fx),
    ui.grounds($('#uses-list'), fx, { skip: el => !el.classList.contains('use__ground') }),
  ]);
  if (location.hash) { try { document.querySelector(location.hash)?.scrollIntoView(); } catch { /* not an id */ } }
  if (q.get('play')) { const t = tiles.find(x => x.meta.id === q.get('play')); if (t) { t.el.scrollIntoView({ block: 'center' }); playTile(t, true); } }
  document.documentElement.dataset.ready = '1';
  window.__gal = {
    gl: () => ({ live: liveGL(), peak: glPeak }), resetPeak() { glPeak = liveGL(); },
    glList: () => { liveGL(); return [...glSet].map(c => { const el = c.canvas; const host = el.isConnected ? el.closest('[id]') : null; return (host ? host.id : el.isConnected ? '?' : 'detached') + (el.width ? ` ${el.width}x${el.height}` : ''); }); },
    tiles, hero, cardGroups, uses, things, photoParts, sceneParts, scene, pickScene, setKind, setCardTheme, deal: dealAndDraw, playTile, stopTile, fx, ui,
  };
</script>
</body>
</html>
