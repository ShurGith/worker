      <h2>One assistant for the whole inbox. <span>It answers, acts and asks for help when it should.</span></h2>
      <span class="sec__tag">01 / 2x2 grid</span>
    </div>
    <div class="g2">
      <article class="card card--row">
        <h3>Answers from your help center</h3>
        <p>Relay reads your help articles and past replies, and shows where each answer came from.</p>
        <div class="panel" data-fx="gradient-mesh" data-fx-seed="5" data-fx-palette='{"bg":"#d9ccb7","surface":"#e9e0d2","ink":"#2a2622","muted":"#6f675c","accent":"#a8794a"}' data-fx-params='{"speed":0,"calm":0.2,"calmX":0.45,"calmY":0.95,"tint":0.6,"relief":0.35}' style="--calm-k:0%">
