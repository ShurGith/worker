  --display-weight: 500; --display-tracking: -0.035em; --display-tracking-xl: -0.045em; --ly-scale: 1;
}
/* the collage's pieces: sized in % of the collage, their text in container units, so the phone shows the same picture smaller */
.ly-collage { container-type: inline-size; }
.ly-collage .ly-piece { box-shadow: 0 1px 2px rgb(0 0 0 / .1), 0 22px 48px -22px rgb(0 0 0 / .4); }
.ly-collage .pc-menu { background: #f6efe2; color: #2a2119; padding: 6cqw 5.5cqw; display: grid; align-content: start; gap: 2.2cqw; font: 400 max(13px, 2.1cqw)/1.35 "Host Grotesk", sans-serif; }
