    const g = [...g0.filter((y) => y.doc), ...g0.filter((y) => !y.doc)]; // (the first place it shows leads)
    const t = told.get(key);
    if (t && (t.shown || !g[0].doc)) continue;
    const k = g[0].check + '|' + g[0].sel;
