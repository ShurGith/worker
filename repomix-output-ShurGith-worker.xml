<script>
  const sw = document.getElementById('theme'), h = document.documentElement;
  sw.setAttribute('aria-checked', String(h.dataset.theme === 'dark'));
  sw.addEventListener('click', e => {
    e.preventDefault();
    const dark = h.dataset.theme !== 'dark';
    if (dark) h.dataset.theme = 'dark'; else delete h.dataset.theme;
    sw.setAttribute('aria-checked', String(dark));
  });
</script>
