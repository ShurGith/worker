  // quoted is what was found in it (the pair, the number, the street), and the link's host is named after it
  if (o.href) {
    const h = String(t).trim();
    const inLink = ', in a link (' + ((h.match(/^https?:\/\/([^\/?#]+)/i) || [])[1] || h.replace(/[?#].*$/, '').slice(0, 40)) + ')';
