  .copy:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .copy em { font-style: normal; display: inline-grid; place-items: center; height: 24px; padding: 0 8px; border-radius: 6px; background: color-mix(in oklab, var(--ink) 7%, transparent); font-family: var(--font-text); font-size: 12px; overflow: hidden; }
  .copy em span { grid-area: 1 / 1; transition: transform 260ms var(--ease), opacity 200ms ease; }
  .copy em span + span { transform: translateY(110%); opacity: 0; }
  .copy.done em span:first-child { transform: translateY(-110%); opacity: 0; }
  .copy.done em span + span { transform: none; opacity: 1; }

