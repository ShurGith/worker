        const q = Math.min(p, e.len);
        e.lit.setAttribute('stroke-dasharray', f.dir > 0 ? `${r1(q)} ${r1(e.len + 2)}` : `0 ${r1(e.len - q)} ${r1(q)} ${r1(e.len + 2)}`);
