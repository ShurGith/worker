    if (!v || !/^print-[a-z]+(:[a-z]+)?$/.test(v)) return;
    const [id, effect] = v.split(':');
    el.dataset.print = id;
    if (effect) el.dataset.printParams = JSON.stringify({ effect });
  });
  const auto = (await import('../../objects/_print-core/auto.js')).default;
  await Promise.all([ui.grounds(document, fx), auto.mountAll(document)]);
