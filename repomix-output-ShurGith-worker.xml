      type: 'checkpoint',
      id,
      revision: sessionState.nextCheckpointRevision(),
      revisionDomain: 'browser',
      owner: browserOwner,
      phase: 'steer',
      reason,
      pageUrl: location.pathname,
      ...(extra || {}),
