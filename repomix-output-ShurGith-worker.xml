<script type="module">
  import fx from '../effects/fx.js';
  import ui from './ui.js';
  const q = new URLSearchParams(location.search);
  if (q.has('t')) fx.setClock(+q.get('t'));
  const root = document.documentElement;
  const saved = (() => { try { return localStorage.getItem('cards-theme'); } catch { return null; } })();
  const theme0 = q.get('theme') || saved || 'light';

  // per-theme effect ids and params: data-fx-dark / data-fx-params-dark override on dark
  for (const el of document.querySelectorAll('[data-fx]')) { el.dataset.fxLight = el.dataset.fx; el.dataset.fxParamsLight = el.dataset.fxParams || ''; }
  function apply(theme) {
    root.dataset.theme = theme;
    for (const b of document.querySelectorAll('[data-set-theme]')) b.setAttribute('aria-pressed', String(b.dataset.setTheme === theme));
    for (const el of document.querySelectorAll('[data-fx-light]')) {
      const dark = theme === 'dark';
      el.dataset.fx = dark && el.dataset.fxDark ? el.dataset.fxDark : el.dataset.fxLight;
      const p = dark && el.dataset.fxParamsDark ? el.dataset.fxParamsDark : el.dataset.fxParamsLight;
      if (p) el.dataset.fxParams = p; else delete el.dataset.fxParams;
      // the big number: a light effect under white text on dark (darken), a dark one under black text on light (lighten)
      if (el.hasAttribute('data-knock')) {
        el.classList.toggle('knock--light', !dark);
        el.dataset.fxPalette = JSON.stringify(dark
          ? { bg: '#f2efea', surface: '#ffffff', ink: '#1a1a1a', muted: '#9a948c', accent: '#a9a397' }
          : { bg: '#121110', surface: '#262422', ink: '#f2f2ef', muted: '#77736d', accent: '#5e5953' });
        // held still: a number that keeps moving would be a loop with no pause button
        el.dataset.fxParams = JSON.stringify({ speed: 0, grainMotion: 0, calm: 0, tint: 0.9, contrast: 0.85, grain: 0.5, softness: 0.4 });
      }
    }
  }
  // The featured plan rests on a quiet accent hairline (cards.css). On hover or keyboard focus a light runs
  // once round its edge (edge-glow, mounted for that one lap of about 4.6 s, then faded and freed), so
  // nothing on the card moves on its own or because the page scrolled.
  function glowOnHover() {
    for (const el of document.querySelectorAll('[data-glow]')) {
      let busy = false;
      const lap = async () => {
        if (busy || ui.reduced()) return;
        busy = true;
        try {
          const c = await fx.mount(el, el.dataset.glow, { palette: fx.readPalette(el), params: JSON.parse(el.dataset.glowParams || '{}'), seed: 2 });
          const r = el.getBoundingClientRect(), per = 2 * (r.width + r.height);
          await new Promise(res => setTimeout(res, per / Math.min(c.params.speed, per / 4) * 1000));
          el.classList.add('is-fading');
          await new Promise(res => setTimeout(res, 650));
          c.destroy();
        } catch (e) { console.warn(e); }
        el.classList.remove('is-fading');
        busy = false;
      };
      el.addEventListener('pointerenter', lap);
      el.addEventListener('focusin', lap);
      fx.load(el.dataset.glow).catch(() => {});    // the shader module is ready before the first hover
    }
  }

  apply(theme0);
  // one loop per card group carries data-ui-loop; ui.loadAll / ui.startAll hold every other fragment on its
  // finished picture (and on a phone every fragment but voice), the same rule system.js applies.
  // ui.grounds draws each still ground once and frees its WebGL context: the page needs one or two
