@media (max-width: 639px) { .ux__body { grid-template-columns: 1fr; } .ux__side { display: none; } .ux__main { padding: var(--s-4); } .ux__tiles { grid-template-columns: 1fr 1fr; } .ux__tile:nth-child(3) { display: none; } }
