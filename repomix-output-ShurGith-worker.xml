<script id="paths" type="application/json">{"root": "../"}</script>
<script type="module">
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const ROOT = JSON.parse($('#paths').textContent).root;
  const A = p => new URL(ROOT + p, location.href).href;
  const q = new URLSearchParams(location.search);
  const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const frame = () => new Promise(r => requestAnimationFrame(() => r()));

  /* ---------------------------------------------------------------- WebGL count (window.__gal.gl()) */
  // a context counts while it is not lost and its canvas is in the page (a canvas a part dropped
  // without losing its context draws nothing and is collected)
  const glSet = new Set();
  let glPeak = 0;
  const liveGL = () => { let n = 0; for (const c of glSet) { if (c.isContextLost()) glSet.delete(c); else if (c.canvas.isConnected) n++; } return n; };
  const getContext = HTMLCanvasElement.prototype.getContext;
  HTMLCanvasElement.prototype.getContext = function (type, ...rest) {
    const c = getContext.call(this, type, ...rest);
    if (c && /webgl/i.test(type) && !glSet.has(c)) { glSet.add(c); glPeak = Math.max(glPeak, liveGL() + (this.isConnected ? 0 : 1)); }
    return c;
  };
  // the page's budget: a part that needs WebGL of its own starts only while fewer than BUDGET are live
  // (the hero, the tile pointed at, a ground being drawn, the components and objects in view)
  const BUDGET = 4;
  const roomQueue = [];
  let reserved = 0, roomTimer = 0;
  function whenRoom(want, go) {
    const run = () => { reserved++; setTimeout(() => { reserved--; }, 1500); go(); };
    if (liveGL() + reserved < BUDGET) { run(); return; }
    roomQueue.push({ want, run });
    if (!roomTimer) roomTimer = setInterval(() => {
      for (let i = 0; i < roomQueue.length; i++) {
        const w = roomQueue[i];
        if (!w.want()) { roomQueue.splice(i--, 1); continue; }
        if (liveGL() + reserved < BUDGET) { roomQueue.splice(i--, 1); w.run(); }
      }
      if (!roomQueue.length) { clearInterval(roomTimer); roomTimer = 0; }
    }, 300);
  }

  const [{ default: fx }, { pick }, { default: ui }] = await Promise.all([
    import(A('effects/fx.js')), import(A('effects/pick.js')), import(A('ui/ui.js')),
  ]);
  if (q.has('time')) fx.setClock(+q.get('time'));
  if (q.has('fallback')) fx.config.forceFallback = true;
  fx.config.maxLive = 3;
  fx.config.maxDpr = 1;
  $('#lab-link').href = A('effects/lab.html');

  /* ---------------------------------------------------------------- palettes */
  // the effects' palette for each kind of page (the page's own tokens are in the CSS above)
  const FXP = {
    // a surface a clear step under the paper, so a light effect has a second tone to draw with
    light: { bg: '#f3f3f1', surface: '#dad7cf', ink: '#0f0f0e', muted: '#686863', accent: '#e5531c', accentInk: '#ffffff' },
    dark: { bg: '#070708', surface: '#151517', ink: '#f2f2ef', muted: '#8f9094', accent: '#ff7a3c', accentInk: '#120c08' },
    // on cobalt the effects draw in a deep navy, a sky blue and white, so a ground has depth, not one flat blue
    // (the page's yellow stays for its buttons: most effects drop an accent that far round the wheel)
    colour: { bg: '#0034eb', surface: '#001c96', ink: '#ffffff', muted: '#dfe4f2', accent: '#5cc6ff', accentInk: '#00135c' },
  };
  const KIND_WORDS = { light: 'light', dark: 'dark', colour: 'colour' };
  // lit grounds behind UI (references/cards.md), the same on both card themes
  const LIT = {
    sky: { bg: '#c6d3df', surface: '#d6e0e9', ink: '#25303a', muted: '#5d6873', accent: '#3f6a92' },
    sand: { bg: '#d9ccb7', surface: '#e9e0d2', ink: '#2a2622', muted: '#6f675c', accent: '#a8794a' },
    sage: { bg: '#cdd6c6', surface: '#dce3d6', ink: '#262d24', muted: '#5f6a5a', accent: '#6c8e63' },
    painting: { bg: '#79a8d6', accent: '#9c9b3c' },
  };
  let kind = ['light', 'dark', 'colour'].includes(q.get('palette')) ? q.get('palette')
    : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  const kindFor = meta => (meta.palettes.includes(kind) ? kind : meta.palettes.includes('dark') ? 'dark' : meta.palettes[0]);

  const FAMILIES = { grain: 'Grain', dither: 'Dither', mesh: 'Mesh', light: 'Light', pattern: 'Pattern', material: 'Material', photo: 'Photo' };
  const famName = f => FAMILIES[f] || f[0].toUpperCase() + f.slice(1);
  const SLOT_WORDS = { hero: 'hero frames', card: 'cards', band: 'bands', footer: 'footers' };
  const andList = a => (a.length < 2 ? a.join('') : `${a.slice(0, -1).join(', ')} and ${a[a.length - 1]}`);
  const upper = s => s[0].toUpperCase() + s.slice(1);

  function toast(msg, ms = 2400) {
    const el = $('#toast');
    el.textContent = msg;
    el.classList.add('on');
    clearTimeout(toast.t);
    toast.t = setTimeout(() => el.classList.remove('on'), ms);
  }
  function syncUrl() {
    try {
      const u = new URL(location.href);
      u.searchParams.set('palette', kind);
      if (dealSeed) u.searchParams.set('deal', dealSeed);
      u.searchParams.set('cards', cardTheme);
      history.replaceState(null, '', u);
    } catch { /* a sandboxed frame may refuse; the page works without it */ }
  }

  /* ---------------------------------------------------------------- a still picture of a live canvas */
  // the same picture ui.grounds keeps: a 2D copy of the last frame under everything in the box, its
  // WebGL context freed. Returns a stub controller ui.grounds can replace later.
  function keepFrame(el, api) {
    const src = el.querySelector(':scope > canvas.fx-canvas:not(.is-baked)');
    let out = null;
    if (src && src.width && src.style.opacity !== '0') {
      try { api.set && api.set({}); } catch { /* no set: the copy below still holds the last frame */ }
      out = document.createElement('canvas');
      out.width = src.width; out.height = src.height;
      try { out.getContext('2d').drawImage(src, 0, 0); } catch { out = null; }
    }
    api.destroy();
    if (!out) return null;
    out.className = 'fx-canvas is-baked';
    out.setAttribute('aria-hidden', 'true');
    Object.assign(out.style, { position: 'absolute', inset: '0', width: '100%', height: '100%', display: 'block', zIndex: '-1', pointerEvents: 'none', borderRadius: 'inherit' });
    el.insertBefore(out, el.firstChild);
    const stub = { id: api.id, el, baked: true, pause() {}, resume() {}, set() { return stub; }, setPalette() { return stub; },
      destroy() { out.remove(); if (el.__fx === stub) delete el.__fx; el.removeAttribute('data-fx-mounted'); } };
    el.__fx = stub;
    el.setAttribute('data-fx-mounted', api.id);
    return stub;
  }
  // mount a live effect over the picture already in the box; the picture goes once the first frame shows
  async function goLive(el, id, spec) {
    const old = el.__fx;
    if (old && old.baked) delete el.__fx;          // keep its picture under the live canvas for now
    const api = await fx.mount(el, id, spec);
    (async () => {
      for (const t0 = performance.now(); performance.now() - t0 < 8000; await frame()) {
        if (el.__fx !== api) return;
        const c = el.querySelector(':scope > canvas.fx-canvas:not(.is-baked)');
        if ((c && c.style.opacity === '1') || el.dataset.fxFallback) break;
      }
      if (el.__fx === api) for (const b of el.querySelectorAll(':scope > canvas.is-baked')) b.remove();
    })();
    return api;
  }

  /* ---------------------------------------------------------------- data */
  let index;
  try {
    index = await fetch(A('effects/index.json'), { cache: 'no-store' }).then(r => { if (!r.ok) throw new Error(r.status); return r.json(); });
  } catch (err) {
    $('#fx-grid').innerHTML = '<p class="fx-empty">The effects index did not load. Serve this folder over http.</p>';
    throw err;
  }
  const byId = Object.fromEntries(index.effects.map(e => [e.id, e]));
  const nameOf = id => (byId[id] || { name: id }).name;
  const N = index.effects.length;
  $('#fx-title').firstChild.textContent = `${N} effects. `;
  $('#see-all').textContent = `See all ${N} effects`;
  $('#hero-sub').textContent = $('#hero-sub').textContent.replace(/^\d+/, N);

  /* ---------------------------------------------------------------- the hero ground */
  const hero = { el: $('#hero-frame'), api: null, id: null, seed: 0, visible: true, paused: false, tweaks: {} };
  const heroSpec = () => ({ palette: FXP[kind], seed: hero.seed, params: { calm: 0, ...hero.tweaks } });
  async function mountHero() {
    if (!hero.id) return;
    const gen = (hero.gen = (hero.gen || 0) + 1);
    hero.el.style.backgroundColor = FXP[kind].bg;
    if (!hero.visible) { if (hero.api) { keepFrame(hero.el, hero.api); hero.api = null; } return; }
    try {
      const api = await goLive(hero.el, hero.id, heroSpec());
      if (gen !== hero.gen) { if (hero.el.__fx === api) api.destroy(); return; }
      hero.api = api;
      if (hero.paused) api.pause();
    } catch (err) { console.warn('hero', err); }
    const m = byId[hero.id];
    $('#hero-cap').innerHTML = `<b>${esc(m.name)}</b> &middot; ${esc(famName(m.family))} &middot; dealt for the hero, seed ${hero.seed}`;
    $('#hero-tile').href = '#fx-' + hero.id;
    dock();
  }
  // the dock: name, a few of the effect's own parameters as live sliders, the palette and the code
  const humanize = k => upper(k.replace(/([a-z])([A-Z])/g, '$1 $2').toLowerCase());
  const fmt = (v, step) => (+v).toFixed(step >= 1 ? 0 : step >= 0.1 ? 1 : 2);
  // a slider only for a range (a switch or a choice of modes is left to the workbench)
  const isRange = s => typeof s.default === 'number' && s.max > s.min && !((s.step || 0) >= 1 && s.max - s.min <= 4);
  function dock() {
    const m = byId[hero.id];
    if (!m) return;
    $('#dock-name').textContent = m.name;
    $('#dock-meta').textContent = `${famName(m.family)} · seed ${hero.seed}`;
    $('#dock-code').textContent = `<div data-fx="${m.id}" data-fx-seed="${hero.seed}"></div>`;
    const P = FXP[kind];
    $('#dock-pal').innerHTML = ['bg', 'surface', 'ink', 'accent'].map(k => `<i style="background:${P[k]}" title="${k}"></i>`).join('') + `<span style="margin-left:4px">${upper(kind)}</span>`;
    const api = hero.api && !hero.api.baked ? hero.api : null;
    const schema = api?.effect?.params || {};
    const keys = Object.keys(schema).filter(k => !/^(calm|seed)/i.test(k) && isRange(schema[k])).slice(0, 4);
    if (!api) return;   // off screen: the rows stay as they were
    $('#dock-rows').innerHTML = keys.map(k => {
      const s = schema[k], step = s.step || +((s.max - s.min) / 100).toPrecision(2), v = api.params[k] ?? s.default;
      return `<div class="dock__row"><label for="dock-${k}">${esc(humanize(k))}</label><output id="dock-out-${k}">${fmt(v, step)}</output>
        <input type="range" id="dock-${k}" data-k="${k}" min="${s.min}" max="${s.max}" step="${step}" value="${v}" style="--v:${((v - s.min) / (s.max - s.min) * 100).toFixed(1)}%"></div>`;
    }).join('');
  }
  $('#dock-rows').addEventListener('input', e => {
    const r = e.target.closest('input[data-k]');
    if (!r) return;
    const k = r.dataset.k, v = +r.value;
    r.style.setProperty('--v', `${((v - +r.min) / (+r.max - +r.min) * 100).toFixed(1)}%`);
    $('#dock-out-' + k).textContent = fmt(v, +r.step);
    hero.tweaks[k] = v;
    if (hero.api && !hero.api.baked) hero.api.set({ [k]: v });
  });
  $('#dock-seed').addEventListener('click', () => { hero.seed = Math.floor(Math.random() * 10000); mountHero(); });
  $('#dock-copy').addEventListener('click', async () => {
    const code = $('#dock-code').textContent;
    try { await navigator.clipboard.writeText(code); toast('Copied ' + code); } catch { toast(code, 5000); }
  });
  ui.pausable(hero.el, { pause() { hero.paused = true; hero.api?.pause(); }, resume() { hero.paused = false; hero.api?.resume(); } });
  new IntersectionObserver(es => {
    const vis = es[es.length - 1].isIntersecting;
    if (vis === hero.visible) return;
    hero.visible = vis;
    if (!vis && hero.api) { hero.gen++; keepFrame(hero.el, hero.api); hero.api = null; }
    else if (vis && !hero.api) mountHero();
  }, { rootMargin: '0px' }).observe(hero.el);
  $('#hero-seed').addEventListener('click', () => { hero.seed = Math.floor(Math.random() * 10000); mountHero(); });

  /* ---------------------------------------------------------------- 1. effect tiles */
  const ORDER = Object.keys(FAMILIES);
  const famIndex = f => (ORDER.includes(f) ? ORDER.indexOf(f) : 99);
  const tiles = [];
  const photoSrc = A('objects/photo-kit/photos/room.jpg');
  function tileSpec(t) {
    const k = kindFor(t.meta);
    t.stage.dataset.fxPalette = JSON.stringify(FXP[k]);
    t.stage.dataset.fxSeed = String(t.seed);
    t.stage.style.backgroundColor = FXP[k].bg;   // under an effect that draws only its marks
    const fits = k === kind;
    t.badge.hidden = fits;
    if (!fits) t.badge.textContent = `Made for ${andList(t.meta.palettes.map(x => KIND_WORDS[x]))} pages`;
    return { palette: FXP[k], seed: t.seed };
  }
  function buildTile(meta) {
    const el = document.createElement('article');
    el.className = 'fx-tile';
    el.id = 'fx-' + meta.id;
    el.dataset.family = meta.family;
    const moves = meta.motion !== 'still';
    el.innerHTML = `
      <div class="fx-stage" data-fx="${esc(meta.id)}">
        ${meta.usesImg ? `<img data-fx-photo src="${esc(photoSrc)}" alt="" crossorigin="anonymous">` : ''}
        <span class="fx-badge" hidden></span>
        ${moves ? `<button type="button" class="fx-play" aria-label="Play ${esc(meta.name)}"><svg class="i-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.8v8.4L10.2 6z"/></svg><svg class="i-pause" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 1.5h2.6v9H2.5zM6.9 1.5h2.6v9H6.9z"/></svg></button>` : ''}
      </div>
      <div class="fx-info">
        <div class="fx-top"><h3>${esc(meta.name)}</h3><span class="fx-fam">${esc(famName(meta.family))}</span></div>
        <p class="fx-look">${esc(meta.look)}</p>
        <div class="fx-foot">
          <span class="fx-for">${esc(forLine(meta))}</span>
          <span class="fx-acts"><button type="button" class="textbtn" data-act="seed">New seed</button><button type="button" class="textbtn" data-act="copy">Copy code</button></span>
        </div>
      </div>`;
    const t = { meta, el, stage: el.querySelector('.fx-stage'), badge: el.querySelector('.fx-badge'), seed: 100 + fx.hashSeed(meta.id) % 900, api: null, pinned: false, visible: false };
    tileSpec(t);
    el.querySelector('[data-act="seed"]').addEventListener('click', () => {
      t.seed = Math.floor(Math.random() * 10000);
      tileSpec(t);
      if (t.api) { const live = t.api; t.api = null; liveTile = null; live.destroy(); el.classList.remove('is-playing'); playTile(t, t.pinned); }
      else ui.grounds(t.stage, fx);
    });
    el.querySelector('[data-act="copy"]').addEventListener('click', async () => {
      const code = `<div data-fx="${meta.id}" data-fx-seed="${t.seed}"></div>`;
      try { await navigator.clipboard.writeText(code); toast('Copied ' + code); } catch { toast(code, 5000); }
    });
    if (moves) {
      const btn = el.querySelector('.fx-play');
      btn.addEventListener('click', () => {
        if (t.api && t.pinned) { t.pinned = false; stopTile(t); }
        else playTile(t, true);
      });
      t.stage.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse') playTile(t, false); });
      t.stage.addEventListener('pointerleave', e => { if (e.pointerType === 'mouse' && !t.pinned) stopTile(t); });
    }
    return t;
  }
  function forLine(meta) {
    const slots = ['hero', 'card', 'band', 'footer'].filter(s => meta.bestOn.includes(s)).map(s => SLOT_WORDS[s]);
    let s = `For ${andList(slots)}`;
    if (meta.motion === 'still') s += ', still';
    if (meta.random === false) s += '. Chosen on purpose, never dealt';
    return s;
  }
  // one tile plays at a time: the one pointed at, or the one whose play button was pressed
  let liveTile = null;
  async function playTile(t, pin) {
    if (liveTile && liveTile !== t) { liveTile.pinned = false; stopTile(liveTile); }
    t.pinned = t.pinned || pin;
    if (t.api || t.starting) return;
    liveTile = t;
    t.starting = true;
    t.el.classList.add('is-playing');
    t.el.querySelector('.fx-play')?.setAttribute('aria-label', `Pause ${t.meta.name}`);
    try {
      const api = await goLive(t.stage, t.meta.id, tileSpec(t));
      t.starting = false;
      if (liveTile !== t) { keepFrame(t.stage, api); return; }
      t.api = api;
    } catch (err) { t.starting = false; console.warn(t.meta.id, err); }
  }
  function stopTile(t) {
    if (liveTile === t) liveTile = null;
    t.el.classList.remove('is-playing');
    t.el.querySelector('.fx-play')?.setAttribute('aria-label', `Play ${t.meta.name}`);
    const api = t.api;
    t.api = null;
    if (api && t.stage.__fx === api) keepFrame(t.stage, api);
  }
  const tileIO = new IntersectionObserver(es => {
    for (const e of es) {
      const t = tiles.find(x => x.stage === e.target);
      if (t && !e.isIntersecting && t.api) { t.pinned = false; stopTile(t); }
    }
  });

  const sorted = [...index.effects].sort((a, b) => famIndex(a.family) - famIndex(b.family) || a.name.localeCompare(b.name));
  for (const meta of sorted) { const t = buildTile(meta); tiles.push(t); $('#fx-grid').append(t.el); tileIO.observe(t.stage); }
  let family = q.get('family') || '';
  function orderTiles() {
    const fits = t => t.meta.palettes.includes(kind);
    for (const t of [...tiles.filter(fits), ...tiles.filter(t => !fits(t))]) $('#fx-grid').append(t.el);
  }
  function filterTiles() {
    if (family && !tiles.some(t => t.meta.family === family)) family = '';
    for (const t of tiles) t.el.hidden = !!family && t.meta.family !== family;
    for (const b of $$('#families button')) b.setAttribute('aria-pressed', String(b.dataset.family === family));
  }
  {
    const counts = {};
    for (const e of index.effects) counts[e.family] = (counts[e.family] || 0) + 1;
    const fams = Object.keys(counts).sort((a, b) => famIndex(a) - famIndex(b));
    const make = (key, label, n) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.dataset.family = key;
      b.innerHTML = `${esc(label)} <span>${n}</span>`;
      b.addEventListener('click', () => { family = key; filterTiles(); });
      $('#families').append(b);
    };
    make('', 'All', index.effects.length);
    for (const f of fams) make(f, famName(f), counts[f]);
  }

  /* ---------------------------------------------------------------- 2. cards: the layouts of ui/cards.html */
  // the layouts are read from ui/cards.html at load, so the gallery always shows the kit's current cards;
  // its page styles are kept to the layouts with @scope
  function scopeCSS(css, scope) {
    css = css.replace(/\/\*[\s\S]*?\*\//g, '');
    const out = [];
    let i = 0;
    const block = start => { let d = 0; for (let j = start; j < css.length; j++) { if (css[j] === '{') d++; else if (css[j] === '}' && --d === 0) return j; } return css.length - 1; };
    while (i < css.length) {
      const open = css.indexOf('{', i);
      if (open < 0) break;
      const prelude = css.slice(i, open).trim();
      const end = block(open);
      const body = css.slice(open + 1, end);
      if (/^@media|^@supports|^@container/.test(prelude)) out.push(`${prelude} { @scope (${scope}) { ${body} } }`);
      else if (/^@(keyframes|font-face|property)/.test(prelude)) out.push(`${prelude} {${body}}`);
      else if (prelude && !/^:root$/.test(prelude) && !/^(html|body)(\s*,\s*(html|body))*$/.test(prelude)) out.push(`@scope (${scope}) { ${prelude} {${body}} }`);
      i = end + 1;
    }
    return out.join('\n');
  }
  const cardlib = $('#cardlib');
  let cardTheme = ['light', 'dark'].includes(q.get('cards')) ? q.get('cards') : (kind === 'light' ? 'light' : 'dark');
  const cardGroups = [];
  try {
    const html = await fetch(A('ui/cards.html'), { cache: 'no-store' }).then(r => { if (!r.ok) throw new Error(r.status); return r.text(); });
    const doc = new DOMParser().parseFromString(html, 'text/html');
    const style = document.createElement('style');
    style.textContent = scopeCSS([...doc.querySelectorAll('head style')].map(s => s.textContent).join('\n'), '#cardlib');
    document.head.append(style);
    const secs = [...doc.querySelectorAll('main section.sec')];
    cardlib.replaceChildren(...secs.map(s => document.importNode(s, true)));
    for (const sec of $$(':scope > .sec', cardlib)) {
      sec.id = 'cards-' + sec.id;
      const tag = sec.querySelector('.sec__tag');
      const label = (tag?.textContent || '').replace(/^\s*\d+\s*\/\s*/, '').trim() || sec.id;
      const meta = document.createElement('div');
      meta.className = 'sec__meta';
      if (tag) { tag.replaceWith(meta); meta.append(tag); } else sec.querySelector('.sec__head')?.append(meta);
      const panels = $$('[data-fx]:not([data-knock])', sec);
      // a group is dealt when nothing in it drives its ground (the slider in the bento changes its grain)
      const driven = panels.some(p => p.hasAttribute('data-fx-live') || $$('[data-ui-opts]', p).some(f => /"drive"/.test(f.dataset.uiOpts || '')));
      for (const p of panels) { p.dataset.fxOrig = p.dataset.fx; p.dataset.fxPaletteOrig = p.dataset.fxPalette || ''; p.dataset.fxParamsOrig = p.dataset.fxParams || ''; }
      let ground = null;
      if (panels.length) { ground = document.createElement('span'); ground.className = 'sec__ground'; meta.append(ground); }
      cardGroups.push({ sec, label, panels, driven, ground });
      const a = document.createElement('a');
      a.href = '#' + sec.id;
      a.textContent = label;
      $('#layout-nav').append(a);
    }
    for (const el of $$('[data-fx]', cardlib)) { el.dataset.fxLight = el.dataset.fx; }
  } catch (err) {
    cardlib.innerHTML = '<p class="cardlib-load">The card layouts did not load (ui/cards.html).</p>';
    console.warn('cards', err);
  }
  function applyCardTheme() {
    const band = $('#cards');
    band.dataset.theme = cardTheme;
    cardlib.dataset.theme = cardTheme;
    for (const b of $$('#card-theme button')) b.setAttribute('aria-pressed', String(b.dataset.themeSet === cardTheme));
    const dark = cardTheme === 'dark';
    // the big number: a light effect under white text on dark (darken), a dark one under black text on light (lighten)
    for (const el of $$('[data-knock]', cardlib)) {
      el.classList.toggle('knock--light', !dark);
      el.dataset.fxPalette = JSON.stringify(dark
        ? { bg: '#f2efea', surface: '#ffffff', ink: '#1a1a1a', muted: '#9a948c', accent: '#a9a397' }
        : { bg: '#121110', surface: '#262422', ink: '#f2f2ef', muted: '#77736d', accent: '#5e5953' });
      el.dataset.fxParams = JSON.stringify({ speed: 0, grainMotion: 0, calm: 0, tint: 0.9, contrast: 0.85, grain: 0.5, softness: 0.4 });
    }
  }
  // one effect per dealt group; a group keeps its own lit palettes, and the painting's palette (made for
  // the painterly landscape) becomes the sky for any other effect
  const STILL = { speed: 0, drift: 0, grainMotion: 0 };
  function setGroupGround(g, id) {
    for (const p of g.panels) {
      if (id === p.dataset.fxOrig) {
        p.dataset.fx = id;
        if (p.dataset.fxPaletteOrig) p.dataset.fxPalette = p.dataset.fxPaletteOrig; else delete p.dataset.fxPalette;
        if (p.dataset.fxParamsOrig) p.dataset.fxParams = p.dataset.fxParamsOrig; else delete p.dataset.fxParams;
        let own = {};
        try { own = JSON.parse(p.dataset.fxPaletteOrig || '{}'); } catch { /* none */ }
        p.style.backgroundColor = own.bg || '';
      } else {
        let pal = {};
        try { pal = JSON.parse(p.dataset.fxPaletteOrig || '{}'); } catch { /* none */ }
        if (!pal.ink) pal = LIT.sky;
        let orig = {};
        try { orig = JSON.parse(p.dataset.fxParamsOrig || '{}'); } catch { /* none */ }
        const keep = Object.fromEntries(Object.entries(orig).filter(([k]) => /^calm/.test(k)));
        p.dataset.fx = id;
        p.dataset.fxPalette = JSON.stringify(pal);
        p.dataset.fxParams = JSON.stringify({ ...keep, ...STILL });
        // the lit ground's own paper under the picture: an effect that draws only its lines (grid
        // pulse) never shows the dark panel through them
        p.style.backgroundColor = pal.bg;
      }
      p.dataset.fxLight = p.dataset.fx;
    }
    if (g.ground) g.ground.innerHTML = `Ground: <b>${esc(nameOf(id))}</b>`;
  }
  function glowOnHover() {
    for (const el of $$('[data-glow]', cardlib)) {
      let busy = false;
      const lap = async () => {
        if (busy || ui.reduced()) return;
        busy = true;
        try {
          const c = await fx.mount(el, el.dataset.glow, { palette: fx.readPalette(el), params: JSON.parse(el.dataset.glowParams || '{}'), seed: 2 });
          const r = el.getBoundingClientRect(), per = 2 * (r.width + r.height);
          await sleep(per / Math.min(c.params.speed, per / 4) * 1000);
          el.classList.add('is-fading');
          await sleep(650);
          c.destroy();
        } catch (e) { console.warn(e); }
        el.classList.remove('is-fading');
        busy = false;
      };
      el.addEventListener('pointerenter', lap);
      el.addEventListener('focusin', lap);
    }
  }
  async function setCardTheme(t) {
    if (t === cardTheme) return;
    cardTheme = t;
    applyCardTheme();
    syncUrl();
    await ui.grounds(cardlib, fx);
    for (const el of $$('[data-ui]', cardlib)) el.__ui?.repaint?.();
  }
  for (const b of $$('#card-theme button')) b.addEventListener('click', () => setCardTheme(b.dataset.themeSet));

  /* ---------------------------------------------------------------- the deal: the hero, then the card grounds */
  const HISTORY_KEY = 'fx-gallery-history';
  const readHistory = () => { try { const h = JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]'); return Array.isArray(h) ? h : []; } catch { return []; } };
  const writeHistory = h => { try { localStorage.setItem(HISTORY_KEY, JSON.stringify(h.slice(-100))); } catch { /* no storage */ } };
