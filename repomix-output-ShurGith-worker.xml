  --color-band: oklch(26% 0.045 195); --color-band-ink: oklch(94% 0.012 85);
  --color-slot: oklch(69% 0.07 80);
  --metal-hi: oklch(97% 0.006 85); --metal-lo: oklch(85% 0.01 85);
