      <button type="button" data-set-theme="light" aria-pressed="true">Light</button>
      <button type="button" data-set-theme="dark" aria-pressed="false">Dark</button>
    </div>
  </div>
</header>

<main class="wrap">
  <section class="intro">
    <h1>Relay answers your customers, and hands the hard ones to your team.</h1>
    <p>Relay is an assistant for online shops. It answers customer emails, chats and calls from your help center and order data, and passes the hard cases to a person.</p>
  </section>

  <!-- 1. 2x2 grid ------------------------------------------------------------------------- -->
  <section class="sec" id="grid">
