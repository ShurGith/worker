export async function grounds(root, fx, { skip } = {}) {
  root = root || document;
  if (fx.config) fx.config.maxLive = Math.min(fx.config.maxLive || 3, 3);
  const els = [...root.querySelectorAll('[data-fx]')].filter(el => !(skip && skip(el)));
