.stat-cards .panel::before { display: none; }
.stat-cards .stage > .at-rise { --ax: 20px; --ay: 28px; --fit-max: 300px; }
.d-pane { background: #17191c; color: #e9ecee; border-radius: 12px; padding: 14px 16px; font: 400 13px/1.4 var(--font-text); box-shadow: 0 0 0 1px rgb(255 255 255 / .08), 0 20px 40px -20px rgb(0 0 0 / .7); }
.d-pane h5 { margin: 0 0 10px; font: 500 13px/1.3 var(--font-text); color: #aeb3b8; }
.d-split { display: flex; height: 8px; border-radius: 99px; overflow: hidden; gap: 2px; margin-bottom: 12px; }
.d-split i { display: block; height: 100%; } .d-legend { display: grid; gap: 6px; }
.d-legend span { display: flex; align-items: center; gap: 8px; } .d-legend span::before { content: ""; width: 8px; height: 8px; border-radius: 2px; background: var(--c); }
.d-legend b { margin-left: auto; font-weight: 500; color: #fff; font-variant-numeric: tabular-nums; }
.d-times { display: grid; } .d-times span { display: flex; justify-content: space-between; padding: 7px 0; border-top: 1px solid rgb(255 255 255 / .07); }
.d-times span:first-child { border-top: 0; } .d-times b { font-weight: 500; color: #fff; font-variant-numeric: tabular-nums; }
.d-quote { margin: 0; font-size: 14px; color: #fff; } .d-quote + small { display: block; margin-top: 8px; color: #9aa0a6; }
.d-stars { display: flex; gap: 2px; margin-bottom: 8px; color: #f3c98b; } .d-stars svg { width: 14px; height: 14px; }
