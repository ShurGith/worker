  // still ground once and frees its WebGL context, so this page holds two contexts: the two objects.
  import fx from '../../effects/fx.js';
  import ui from '../ui.js';
  const q = new URLSearchParams(location.search);
  if (q.get('theme')) document.documentElement.dataset.theme = q.get('theme');
  // lab only: ?a=print-lamp:halftone&b=print-book:engrave swaps an object or its print, to compare
  [...document.querySelectorAll('[data-print]')].forEach((el, i) => {
