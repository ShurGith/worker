  function scopeCssBlock(css, prefix) {
    let out = '';
    let i = 0;
    while (i < css.length) {
      const open = css.indexOf('{', i);
      if (open === -1) {
        out += css.slice(i);
        break;
      }
      const semi = css.indexOf(';', i);
      if (semi !== -1 && semi < open) {
        out += css.slice(i, semi + 1);
        i = semi + 1;
        continue;
      }
      const prelude = css.slice(i, open).trim();
      const close = findMatchingCssBrace(css, open);
      if (close === -1) {
        out += css.slice(i);
