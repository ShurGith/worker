    const w = e.target.clientWidth, h = e.target.clientHeight;
    if (Math.abs(w - st.size[0]) < 2 && Math.abs(h - st.size[1]) < 2) continue;
    clearTimeout(st.rt);
    st.rt = setTimeout(() => { st.dirty = true; if (st.near) queueBake(e.target, st.fx, st); }, 250);
  }
