  display: inline-flex; align-items: center; justify-content: center; height: 40px; padding: 0 18px; border-radius: var(--r-btn); border: 0; width: max-content;
  background: var(--action); color: var(--action-ink); font: 500 14px/1 var(--font-text); cursor: pointer; transform-origin: 50% 50%;
