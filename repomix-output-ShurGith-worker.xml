  .foot__base { display: flex; justify-content: space-between; gap: 8px 32px; flex-wrap: wrap; margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 13px; }
  .foot__base a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 4px; }
  @media (max-width: 1023px) { .foot__top { grid-template-columns: minmax(0, 1fr); } }
