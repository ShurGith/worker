  }
  @media (max-width: 760px) {
    :root { --gutter: 16px; }
    .nav, .sw-label { display: none; }
    .hero { padding: 32px 0 40px; }
    .hero__lede { font-size: 17px; }
    .hero__pics { gap: 10px; }
    .pic { border-radius: 16px; }
    .pic--down { margin-top: 28px; }
    .obj { padding: 72px 0; min-height: 0; }
    .obj .wrap { display: flex; flex-direction: column; }
    .obj__head, .obj__about { display: contents; }
    .obj__title { order: 1; margin-bottom: 16px; }
    .obj__line { order: 2; margin-bottom: 28px; }
    .duo { order: 3; }
    .facts { order: 4; margin-top: 28px; }
    .copy, .index { display: none; }
    .facts { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .facts div { display: grid; grid-template-columns: 96px 1fr; gap: 12px; padding: 10px 0; }
    .facts dd { margin: 0; }
    .big { aspect-ratio: 4 / 5; border-radius: 18px; }
    .duo .card > .panel { height: 300px; }
  }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0ms !important; } }
</style>
