<!doctype html>
<html lang="en" data-radius="soft" data-kind="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Effects library</title>
<meta name="description" content="Effects drawn in code for company websites: 25 grounds, eight feature-card layouts, effects inside the page and real things printed in code.">
<link rel="icon" href="data:,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400..600&display=swap" rel="stylesheet">
<!--
  The gallery of the taste-skill effects kit (scripts/fx-gallery.template.html). It is built on the kit
  itself: system.css for the page, ui/cards.css for every card, the layouts of ui/cards.html, the
  components and the objects. Its asset root is "../" (assets/effects/gallery.html); the publish
  command of scripts/effects.mjs moves it to "./" and copies every file it loads beside it.

  Light on a laptop GPU: every still ground is drawn once and kept as a picture (ui.grounds); the hero,
  one effect tile (the one pointed at), the components and the objects near the screen are the only
  live WebGL contexts, and the page keeps them at 4 or fewer (window.__gal.gl() counts them).
-->
<!--assets-->
<link rel="stylesheet" href="../system.css">
<link rel="stylesheet" href="../ui/base.css">
<link rel="stylesheet" href="../ui/cards.css">
<link rel="stylesheet" href="../components/base.css">
<!--/assets-->
<style>
  /* ---------------------------------------------------------------- the three page palettes */
  :root {
    --font-display: "Geist", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-text: "Geist", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-mono: "Geist Mono", ui-monospace, "SFMono-Regular", Consolas, monospace;
    --display-weight: 500;
    --display-tracking: -0.035em;
    --container: 1232px;
  }
  html[data-kind="light"] {
    --p-bg: #f3f3f1; --p-surface: #ffffff; --p-ink: #0f0f0e; --p-muted: #686863; --p-accent: #e5531c; --p-accent-ink: #ffffff;
    --p-action: #0f0f0e; --p-action-ink: #ffffff; --chip: #e9e8e4; --sheet: #ffffff;
    color-scheme: light;
  }
  html[data-kind="dark"] {
    --p-bg: #070708; --p-surface: #151517; --p-ink: #f2f2ef; --p-muted: #8f9094; --p-accent: #ff7a3c; --p-accent-ink: #120c08;
    --p-action: #f2f2ef; --p-action-ink: #070708; --chip: #18181a; --sheet: #111113;
    color-scheme: dark;
  }
  html[data-kind="colour"] {
    --p-bg: #0034eb; --p-surface: #1446ec; --p-ink: #ffffff; --p-muted: #d2dafa; --p-accent: #e9e34a; --p-accent-ink: #111111;
    --p-action: #ffffff; --p-action-ink: #0034eb; --chip: #0f3be4; --sheet: #0b36e0;
    color-scheme: dark;
  }
  body { background: var(--bg); color: var(--ink); }
  ::selection { background: color-mix(in oklab, var(--accent) 30%, transparent); }
  :focus-visible { outline: 2px solid var(--action); outline-offset: 2px; }
  .container { --pad: 24px; }
  @media (min-width: 1024px) { .container { --pad: 40px; } }
  @media (max-width: 639px) { .container { --pad: 16px; } }

  /* ---------------------------------------------------------------- controls */
  .seg { display: inline-flex; padding: 3px; border-radius: 10px; background: var(--chip); box-shadow: inset 0 0 0 1px var(--line); }
  .seg button { height: 30px; padding: 0 12px; border: 0; border-radius: 7px; background: transparent; color: var(--muted); font: 500 13px/1 var(--font-text); cursor: pointer; white-space: nowrap; }
  .seg button:hover { color: var(--ink); }
  .seg button[aria-pressed="true"] { background: var(--card); color: var(--ink); box-shadow: 0 0 0 1px var(--line), 0 1px 2px rgb(0 0 0 / .12); }
  .textbtn { border: 0; background: none; padding: 4px 0; font: 500 14px/20px var(--font-text); color: var(--muted); cursor: pointer;
    text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 4px; }
  .textbtn:hover { color: var(--ink); text-decoration-color: currentColor; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chips button, .chips a { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 12px; border-radius: 999px; border: 0;
    background: transparent; box-shadow: inset 0 0 0 1px var(--line); color: var(--muted); font: 500 13px/1 var(--font-text); cursor: pointer; white-space: nowrap; }
  .chips button:hover, .chips a:hover { color: var(--ink); box-shadow: inset 0 0 0 1px var(--line-strong); }
  .chips span { font-variant-numeric: tabular-nums; opacity: .7; font-weight: 400; }
  .chips [aria-pressed="true"] { background: var(--ink); color: var(--bg); box-shadow: none; }

  /* ---------------------------------------------------------------- nav (system.css .nav, menus filled from the data) */
  .nav { --nav-h: 60px; }
  .nav__bar { gap: 20px; }
  .nav__logo { font: 600 15px/1 var(--font-text); letter-spacing: -0.01em; gap: 10px; }
  .nav__logo svg { width: 20px; height: 20px; }
  .nav__links { gap: 2px; }
  .nav__link { font-size: 14px; }
  .nav__menu { background: var(--sheet); }
  .menu-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px 40px; }
  .menu-col > .t-label { margin-bottom: 4px; }
  .menu-col a { padding: 5px 0; font-size: 14px; }
  .menu-col a span { font-size: 13px; }
  .menu-col a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--line-strong); }
  .nav__actions .btn { height: 36px; padding: 0 14px; font-size: 14px; }
  @media (max-width: 1023px) {
    .nav__bar .seg-phone { display: inline-flex; margin-left: auto; }
    .nav__toggle { margin-left: 0; }
    .nav.is-open .nav__actions .seg { width: 100%; }
    .nav.is-open .nav__actions .seg button { flex: 1; }
  }
  .seg-phone { display: none; }
  @media (max-width: 639px) { .seg-phone button { padding: 0 9px; } .nav__logo .long { display: none; } }

  /* ---------------------------------------------------------------- hero: the dealt hero ground, live */
  .hero { padding: 88px 0 0; text-align: center; }
  .hero__pill { display: inline-flex; align-items: center; gap: 8px; height: 32px; padding: 0 14px 0 12px; border-radius: 999px;
    background: var(--card); box-shadow: inset 0 0 0 1px var(--line); font-size: 13px; color: var(--ink); }
  .hero__pill b { font-weight: 500; }
  .hero__pill .muted { color: var(--muted); }
  .hero__pill svg { width: 12px; height: 12px; color: var(--muted); }
  .hero h1 { margin: 24px auto 0; max-width: 18ch; font-size: clamp(42px, 3.6vw + 18px, 76px); line-height: 1.02; letter-spacing: -0.045em; font-weight: 500; }
  .hero__sub { margin: 22px auto 0; max-width: 58ch; color: var(--muted); font-size: 18px; line-height: 1.55; text-wrap: pretty; }
  .hero .btn-row { justify-content: center; margin-top: 32px; }
  .hero__frame { position: relative; isolation: isolate; overflow: clip; margin-top: 64px; aspect-ratio: 16 / 7; border-radius: 20px; background: var(--card); }
  .hero__frame::after { content: ""; position: absolute; inset: 0; z-index: 4; border-radius: inherit; pointer-events: none; box-shadow: inset 0 0 0 1px var(--line); }
  .hero__cap { display: flex; justify-content: space-between; align-items: baseline; gap: 8px 24px; flex-wrap: wrap; margin-top: 14px; font-size: 14px; line-height: 20px; color: var(--muted); text-align: left; }
  .hero__cap b { color: var(--ink); font-weight: 500; }
  .hero__cap .acts { display: flex; gap: 20px; }

  /* the dock: the hero effect's own settings, live (Figma's Texture card), anchored top-right in the frame */
  html[data-kind="light"] { --dock-bg: #ffffff; --dock-ink: #0f0f0e; --dock-muted: #6b6b66; --dock-line: rgb(15 15 14 / .1); --dock-track: rgb(15 15 14 / .12); }
  html[data-kind="dark"] { --dock-bg: #1a1b1e; --dock-ink: #f2f2ef; --dock-muted: #8f9094; --dock-line: rgb(255 255 255 / .1); --dock-track: rgb(255 255 255 / .14); }
  html[data-kind="colour"] { --dock-bg: #ffffff; --dock-ink: #0f0f0e; --dock-muted: #5b5f6e; --dock-line: rgb(0 20 120 / .12); --dock-track: rgb(0 20 120 / .14); }
  .dock { position: absolute; z-index: 5; top: 28px; right: 28px; width: 300px; max-height: calc(100% - 56px); overflow: auto; scrollbar-width: none; padding: 16px 16px 4px; border-radius: 14px;
    background: var(--dock-bg); color: var(--dock-ink); text-align: left; font-size: 13px; line-height: 18px;
    box-shadow: 0 0 0 1px var(--dock-line), 0 1px 2px rgb(0 0 0 / .06), 0 16px 40px -16px rgb(0 0 0 / .32); }
  .dock__head { display: flex; align-items: center; gap: 12px; padding-bottom: 14px; }
  .dock__head div { display: grid; flex: 1; min-width: 0; }
  .dock__head b { font-weight: 500; font-size: 14px; }
  .dock__head span { color: var(--dock-muted); font-size: 12px; }
  .dock__btn { display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 10px; border: 0; border-radius: 8px; background: transparent; color: var(--dock-ink);
    box-shadow: inset 0 0 0 1px var(--dock-line); font: 500 12px/1 var(--font-text); cursor: pointer; white-space: nowrap; }
  .dock__btn:hover { box-shadow: inset 0 0 0 1px var(--dock-muted); }
  .dock__btn svg { width: 12px; height: 12px; }
  .dock__row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 12px; align-items: center; padding: 10px 0; border-top: 1px solid var(--dock-line); }
  .dock__row label { color: var(--dock-muted); font-size: 12px; }
  .dock__row output { font: 500 12px/1 var(--font-mono); font-variant-numeric: tabular-nums; }
  .dock__row input { grid-column: 1 / -1; }
  .dock input[type="range"] { -webkit-appearance: none; appearance: none; width: 100%; height: 18px; margin: 0; background: transparent; cursor: pointer; }
  .dock input[type="range"]::-webkit-slider-runnable-track { height: 4px; border-radius: 2px; background: linear-gradient(var(--dock-ink), var(--dock-ink)) 0 0 / var(--v, 50%) 100% no-repeat, var(--dock-track); }
  .dock input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 14px; margin-top: -5px; border-radius: 50%; background: var(--dock-bg); box-shadow: 0 0 0 1px var(--dock-muted), 0 1px 3px rgb(0 0 0 / .25); }
  .dock input[type="range"]::-moz-range-track { height: 4px; border-radius: 2px; background: var(--dock-track); }
  .dock input[type="range"]::-moz-range-progress { height: 4px; border-radius: 2px; background: var(--dock-ink); }
  .dock input[type="range"]::-moz-range-thumb { width: 14px; height: 14px; border: 0; border-radius: 50%; background: var(--dock-bg); box-shadow: 0 0 0 1px var(--dock-muted), 0 1px 3px rgb(0 0 0 / .25); }
  .dock input[type="range"]:focus-visible { outline: 2px solid var(--dock-ink); outline-offset: 2px; border-radius: 4px; }
  .dock__pal { display: flex; align-items: center; gap: 6px; }
  .dock__pal i { width: 14px; height: 14px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--dock-line); }
  .dock__code { display: flex; align-items: center; gap: 12px; margin: 0 -16px; padding: 10px 16px 12px; border-top: 1px solid var(--dock-line); }
  .dock__code code { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--dock-muted); font: 12px/18px var(--font-mono); }
  .dock__code .textbtn { color: var(--dock-ink); font-size: 12px; padding: 0; }
  @media (min-width: 900px) { .hero__cap { display: none; } }
  @media (max-width: 899px) { .dock { display: none; } }

  /* ---------------------------------------------------------------- section heads (Figma: ink, then the grey sentence) */
  .sec-intro { display: flex; justify-content: space-between; align-items: end; gap: 24px 48px; flex-wrap: wrap; margin-bottom: 40px; }
  .sec-intro h2 { max-width: 22ch; font-size: clamp(32px, 1.8vw + 18px, 48px); line-height: 1.08; letter-spacing: -0.035em; font-weight: 500; text-wrap: balance; }
  .sec-intro h2 span { color: var(--muted); }
  .sec-intro p { margin-top: 16px; max-width: 58ch; color: var(--muted); font-size: 17px; line-height: 1.55; }
  .block { padding: 136px 0 0; }
  .sub-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px 24px; flex-wrap: wrap; margin: 72px 0 24px; padding-top: 20px; border-top: 1px solid var(--line); }
  .sub-head h3 { font: 500 20px/1.3 var(--font-text); letter-spacing: -0.015em; }
  .sub-head p { color: var(--muted); font-size: 15px; max-width: 60ch; }

  /* ---------------------------------------------------------------- 1. effects: one tile per effect */
  .fx-bar { display: flex; justify-content: space-between; align-items: center; gap: 16px 24px; flex-wrap: wrap; margin-bottom: 32px; }
  .fx-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 56px 24px; }
  @media (min-width: 1200px) { .fx-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 52px 20px; } }
  .fx-tile { min-width: 0; display: flex; flex-direction: column; scroll-margin-top: 96px; }
  .fx-tile[hidden] { display: none; }
  .fx-stage { position: relative; isolation: isolate; overflow: clip; aspect-ratio: 16 / 10; border-radius: 16px; background: var(--card); cursor: default; }
  .fx-stage::after { content: ""; position: absolute; inset: 0; z-index: 4; border-radius: inherit; pointer-events: none; box-shadow: inset 0 0 0 1px var(--line); }
  .fx-stage img[data-fx-photo] { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .fx-play { position: absolute; right: 12px; bottom: 12px; z-index: 6; display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--ink) 16%, transparent); background: var(--bg); color: var(--ink); cursor: pointer;
    box-shadow: 0 1px 2px rgb(0 0 0 / .12), 0 4px 12px -4px rgb(0 0 0 / .28); }
  .fx-play::before { content: ""; position: absolute; inset: -6px; border-radius: 50%; }
  .fx-play svg { width: 12px; height: 12px; fill: currentColor; }
  .fx-play .i-pause, .is-playing .fx-play .i-play { display: none; }
  .is-playing .fx-play .i-pause { display: block; }
  .fx-badge[hidden] { display: none; }
  .fx-badge { position: absolute; left: 12px; top: 12px; z-index: 5; display: inline-flex; align-items: center; height: 26px; padding: 0 10px; border-radius: 999px;
    background: color-mix(in oklab, var(--bg) 88%, transparent); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); font-size: 12px; }
  .fx-info { flex: 1; display: flex; flex-direction: column; gap: 6px; padding: 18px 2px 0; }
  .fx-top { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .fx-top h3 { font: 560 17px/24px var(--font-text); letter-spacing: -0.012em; }
  .fx-fam { flex: none; font-size: 14px; color: var(--muted); }
  .fx-look { color: var(--muted); font-size: 15px; line-height: 1.5; max-width: 62ch; text-wrap: pretty; }
  /* what it is for, then its two actions, level across a row of tiles */
  .fx-foot { display: grid; gap: 6px; margin-top: auto; padding-top: 6px; }
  .fx-for { font-size: 14px; line-height: 20px; color: var(--ink); }
  .fx-acts { display: flex; gap: 18px; }
  .fx-empty { color: var(--muted); padding: 48px 0; }

  /* ---------------------------------------------------------------- 2. cards: the layouts of ui/cards.html, on their own theme */
  .cards-band { margin-top: 136px; padding: 112px 0 128px; background: var(--bg); color: var(--ink); }
  .cards-band[data-theme="light"] {
    --bg: #f3f3f1; --card: #ffffff; --ink: #0f0f0e; --muted: #686863; --accent: #e5531c; --accent-ink: #ffffff; --surface: #ffffff;
    --action: #0f0f0e; --action-ink: #ffffff; --chip: #e9e8e4; color-scheme: light;
  }
  .cards-band[data-theme="dark"] {
    --bg: #070708; --card: #151517; --ink: #f2f2ef; --muted: #8f9094; --accent: #ff7a3c; --accent-ink: #120c08; --surface: #151517;
    --action: #f2f2ef; --action-ink: #070708; --chip: #18181a; color-scheme: dark;
  }
  .cards-band {
    --line: color-mix(in oklab, var(--ink) 11%, transparent); --line-strong: color-mix(in oklab, var(--ink) 20%, transparent);
    --fx-bg: var(--bg); --fx-surface: var(--surface); --fx-ink: var(--ink); --fx-muted: var(--muted); --fx-accent: var(--accent); --fx-accent-ink: var(--accent-ink);
  }
  html[data-kind="light"] .cards-band[data-theme="light"], html[data-kind="dark"] .cards-band[data-theme="dark"] { margin-top: 24px; }
  .cards-band .sec-intro { margin-bottom: 28px; }
  .layout-nav { margin-bottom: 8px; }
  .cardlib .sec { padding-top: 88px; scroll-margin-top: 72px; }
  .cardlib .sec:first-child { padding-top: 48px; }
  .cardlib .sec__head { margin-bottom: 28px; align-items: end; }
  .cardlib .sec__head h2 { font-size: clamp(24px, 0.8vw + 17px, 30px); line-height: 1.15; letter-spacing: -0.025em; max-width: 30ch; }
  .cardlib .sec__meta { display: grid; justify-items: end; gap: 4px; flex: none; text-align: right; }
  .cardlib .sec__meta .sec__tag { padding: 0; }
  .sec__ground { font-size: 13px; line-height: 18px; color: var(--muted); }
