  .obj h2 { margin: 0; font-size: clamp(34px, 1.9vw + 16px, 52px); line-height: 1.04; letter-spacing: -0.035em; font-weight: 520; text-wrap: balance; }
  .obj__about { grid-column: 7 / span 6; }
  .obj__line { margin: 0; font-size: 17px; line-height: 1.5; color: color-mix(in oklab, var(--ink) 82%, var(--bg)); max-width: 52ch; text-wrap: pretty; }
  .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin: 20px 0 0; }
  .facts div { border-top: 1px solid var(--line); padding-top: 10px; }
  .facts dt { font: 500 12px/1 var(--font-mono); color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .facts dd { margin: 8px 0 0; font-size: 14px; line-height: 1.4; }
  .copy { margin-top: 24px; display: inline-flex; align-items: center; gap: 10px; height: 34px; padding: 0 6px 0 12px; border-radius: 9px; border: 1px solid var(--line);
