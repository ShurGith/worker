.pc-menu .it { display: grid; grid-template-columns: 1fr auto; gap: .4cqw 2cqw; padding-top: 2cqw; border-top: 1px solid rgb(42 33 25 / .16); }
.pc-menu .it b { font-weight: 600; } .pc-menu .it small { grid-column: 1; color: #7a6c5d; font-size: max(13px, 1.8cqw); }
.pc-menu .it.is-new span { background: #ffe1d6; color: #b8341c; padding: 0 .8cqw; border-radius: .6cqw; transition: background-color .4s; }
.ly-collage .pc-edit { background: #fff; color: #161616; padding: 3cqw 3.4cqw; display: grid; gap: 1.6cqw; font: 400 max(13px, 2cqw)/1.3 "Host Grotesk", sans-serif; }
.pc-edit .lbl { color: #7b7b78; font-size: max(13px, 1.7cqw); }
.pc-edit .field { display: flex; align-items: center; justify-content: space-between; border: 1px solid #e1e1de; border-radius: 1.4cqw; padding: 1.6cqw 2cqw; font-size: max(13px, 2.4cqw); font-weight: 500; }
.pc-edit .field i { font-style: normal; color: #e2472b; }
.pc-edit .row { display: flex; align-items: center; justify-content: space-between; }
.pc-edit .tg { width: 6.4cqw; height: 3.6cqw; border-radius: 99px; background: #111; position: relative; } .pc-edit .tg::after { content: ""; position: absolute; right: .5cqw; top: .5cqw; width: 2.6cqw; height: 2.6cqw; border-radius: 50%; background: #fff; }
.ly-collage .pc-poster { background: #1d2b23; color: #f3ecdc; display: grid; grid-template-rows: 58% 1fr; }
.pc-poster img { width: 100%; height: 100%; object-fit: cover; }
.pc-poster div { padding: 3.6cqw 4cqw; display: grid; align-content: space-between; }
.pc-poster strong { font: 400 6.8cqw/.95 "Young Serif", Georgia, serif; letter-spacing: -0.02em; }
.pc-poster small { font: 500 max(13px, 1.9cqw)/1.3 "Host Grotesk", sans-serif; opacity: .85; }
.ly-collage .pc-phone { background: #111; border-radius: 4.6cqw; padding: 1.4cqw; }
.pc-phone > div { width: 100%; height: 100%; border-radius: 3.4cqw; overflow: hidden; background: #1d2b23; display: grid; grid-template-rows: 1fr auto; }
.pc-phone img { width: 100%; height: 100%; object-fit: cover; }
.pc-phone p { margin: 0; padding: 2.4cqw 9cqw 2.4cqw 2.4cqw; font: 400 3.6cqw/1.05 "Young Serif", Georgia, serif; color: #f3ecdc; }   /* its right end kept clear: the pause disc sits on this corner */
.ly-collage .pc-swatch { background: #fff; padding: 2.6cqw; display: grid; gap: 1.6cqw; font: 500 max(13px, 1.8cqw)/1.2 "Host Grotesk", sans-serif; color: #161616; }
.pc-swatch .dots { display: flex; gap: 1.4cqw; } .pc-swatch .dots i { width: 4.4cqw; height: 4.4cqw; border-radius: 50%; }
.pc-swatch .dots i.on { box-shadow: 0 0 0 .5cqw #fff, 0 0 0 .9cqw #111; }
.ly-collage .pc-tent { background: #fff; color: #1b1b1b; padding: 6cqw 4cqw; display: grid; gap: 1.2cqw; align-content: center; text-align: center; }
.pc-tent small { font: 500 max(13px, 1.8cqw)/1.2 "Host Grotesk", sans-serif; color: #8a8a86; letter-spacing: .02em; }
.pc-tent strong { font: 400 5cqw/1 "Young Serif", Georgia, serif; letter-spacing: -0.02em; }
.pc-tent span { font: 400 max(13px, 2.2cqw)/1.3 "Host Grotesk", sans-serif; }
.ly-collage .pc-sched { background: #fff; color: #161616; padding: 3cqw; display: grid; gap: 1.4cqw; font: 400 max(13px, 1.9cqw)/1.3 "Host Grotesk", sans-serif; }
.pc-sched b { font-weight: 600; font-size: max(13px, 2.2cqw); }
.pc-sched .ln { display: flex; justify-content: space-between; gap: 2cqw; padding-top: 1.4cqw; border-top: 1px solid #ececea; }
.pc-sched .ln em { font-style: normal; color: #1f7a4d; font-weight: 500; }
/* a phone: the menu keeps three dishes and no notes (its 13px floor would run it past the collage, over the button) */
@media (max-width: 639px) { .pc-menu .it:nth-of-type(n+4), .pc-menu .it small { display: none; } }
.made-row { display: flex; flex-wrap: wrap; gap: var(--s-5) var(--s-7); align-items: baseline; }
.made-row .t-stat { font: var(--display-weight) var(--t-stat)/1 var(--font-display); letter-spacing: var(--display-tracking); }
.tiles3 .tile__media img { object-position: 50% 55%; }
@media (max-width: 639px) { .tiles3 .tile__media { aspect-ratio: 3 / 2; } }
</style>
</head>
