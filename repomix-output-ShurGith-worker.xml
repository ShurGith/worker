<link rel="stylesheet" href="../ui/base.css">
<link rel="stylesheet" href="../ui/cards.css">
<style>
  /* palettes: page tokens, four grounds (--g1 sand, --g2 sky, --g3 sage, --g4 deep) and the globe's sea */
  :root {
    --font-text: "Geist", system-ui, sans-serif; --font-mono: "Geist Mono", ui-monospace, monospace;
    --ease: cubic-bezier(.2, .7, .2, 1);
    --gutter: 32px; --max: 1312px;
  }
  [data-palette="paper"] { --bg: #f6f5f1; --card: #ffffff; --surface: #ffffff; --ink: #111110; --muted: #66655f; --accent: #e5531c; --accent-ink: #ffffff;
    --g1: #e4ddd0; --g2: #d4dee7; --g3: #dbe2d3; --g4: #1a2230; --sea: #2f6aa8; --line: rgb(17 17 16 / 0.09); }
  [data-palette="stone"] { --bg: #e6e5e1; --card: #f3f2ef; --surface: #f3f2ef; --ink: #1a1b1d; --muted: #5d5e62; --accent: #2456d6; --accent-ink: #ffffff;
    --g1: #d6d5d0; --g2: #c9d4df; --g3: #dad3c6; --g4: #1d2633; --sea: #2456d6; --line: rgb(26 27 29 / 0.1); }
  [data-palette="graphite"] { --bg: #0b0b0c; --card: #141416; --surface: #141416; --ink: #f2f2ef; --muted: #96979c; --accent: #ff7a3c; --accent-ink: #120c08;
    --g1: #1e1d1b; --g2: #17202a; --g3: #1b201b; --g4: #23262c; --sea: #4f9be0; --line: rgb(242 242 239 / 0.09); }
  [data-palette="night"] { --bg: #070b14; --card: #0e1420; --surface: #0e1420; --ink: #e9edf3; --muted: #8b94a4; --accent: #5ab9fc; --accent-ink: #07101a;
    --g1: #121a29; --g2: #0f2231; --g3: #16202b; --g4: #1b2536; --sea: #5ab9fc; --line: rgb(233 237 243 / 0.09); }

  * { box-sizing: border-box; }
