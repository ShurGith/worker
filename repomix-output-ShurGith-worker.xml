      if (shouldScopeNestedCssAtRule(prelude)) {
        out += prelude + ' {\n' + scopeCssBlock(body, prefix) + '\n}';
      } else if (prelude.startsWith('@')) {
        out += prelude + ' {' + body + '}';
      } else {
