.mo-la__sub { margin-top: var(--s-6); max-width: 52ch; font-size: var(--t-lead); line-height: 1.5; color: var(--muted); }
.mo-la.is-live { overflow-x: clip; }
.mo-la.is-live .mo-w { display: inline-block; white-space: nowrap; }
.mo-la.is-live .mo-c { display: inline-block; }
.mo-la.is-live .mo-i { display: inline-block; will-change: transform, opacity; }
@media (max-width: 639px) { .mo-la__type { font-size: clamp(48px, 16vw, 96px); } }
@media (prefers-reduced-motion: reduce) { .mo-la .mo-i { transform: none !important; opacity: 1 !important; } }
