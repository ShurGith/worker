const paths = files.map((f) => { try { return fs.statSync(f).isDirectory() ? path.join(f, 'index.html') : f; } catch { return f; } });
const results = [];
for (const f of paths) { try { results.push(lint(f)); } catch (e) { die(`cannot read ${f}: ${e.message}`); } }
