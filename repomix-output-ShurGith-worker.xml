    if (WAIVED.has(b)) { rejectAt(c, 'one waiver per gate'); continue; }
    if (c.reason.length < 24) { rejectAt(c, 'reason under 24 characters'); continue; }
    if (reasonIsBoilerplate(c.reason)) { rejectAt(c, 'boilerplate reason'); continue; }
