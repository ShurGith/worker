<style>
  /* the two page palettes; every colour of the cards, effects and fragments comes from these */
  :root {
    --font-text: "Geist", system-ui, sans-serif;
    --font-display: "Geist", system-ui, sans-serif;
    --font-mono: "Geist Mono", ui-monospace, monospace;
  }
  [data-theme="light"] {
    --bg: #f3f3f1; --card: #ffffff; --ink: #0f0f0e; --muted: #686863; --accent: #e5531c; --accent-ink: #ffffff;
    --g-bg: #e9e8e4; --g-surface: #f6f5f2; --frag: #ffffff;
    --sky: #86a6c8; --sand: #c9a679; --sage: #8fa98d; --warm: #c9a679;
  }
  [data-theme="dark"] {
    --bg: #070708; --card: #151517; --ink: #f2f2ef; --muted: #8f9094; --accent: #ff7a3c; --accent-ink: #120c08;
    --g-bg: #0e0e10; --g-surface: #1b1c1f; --frag: #1c1d20;
    --sky: #7d9bbd; --sand: #c4a173; --sage: #87a184; --warm: #9c9689;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body { font-family: var(--font-text); background: var(--bg); color: var(--ink); -webkit-font-smoothing: antialiased; transition: background-color 300ms ease; }
  ::selection { background: color-mix(in oklab, var(--accent) 30%, transparent); }

  /* every effect ground reads these (the panel's own hue in --hue). A ground that holds UI also takes a
     lit data-fx-palette of its own, the same on both themes: on the dark page it is the bright picture
     behind the dark UI (x.ai), on the light page a clear step darker than the white UI */
  .panel, .panel__screen, .fxg {
    --fx-bg: var(--g-bg); --fx-surface: var(--g-surface); --fx-ink: var(--ink); --fx-muted: var(--muted);
    --fx-accent: var(--hue, var(--sky)); --fx-accent-ink: var(--accent-ink); --calm: var(--g-bg);
  }

  /* page frame */
  .top { position: sticky; top: 0; z-index: 20; background: color-mix(in oklab, var(--bg) 86%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid color-mix(in oklab, var(--ink) 8%, transparent); }
  .top__in { max-width: 1232px; margin: 0 auto; padding: 0 24px; height: 60px; display: flex; align-items: center; gap: 16px; font-size: 14px; line-height: 20px; }
  .top__name { font-weight: 560; letter-spacing: -0.01em; }
  .top__note { color: var(--muted); }
  .top__sp { flex: 1; }
  .seg { display: inline-flex; padding: 3px; border-radius: 10px; background: color-mix(in oklab, var(--ink) 6%, var(--bg)); box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--ink) 6%, transparent); }
  .seg button { font: inherit; font-size: 13px; font-weight: 500; border: 0; background: none; color: color-mix(in oklab, var(--ink) 72%, var(--bg)); height: 30px; padding: 0 14px; border-radius: 7px; cursor: pointer; }
  .seg button[aria-pressed="true"] { background: var(--card); color: var(--ink); box-shadow: 0 0 0 1px color-mix(in oklab, var(--ink) 8%, transparent), 0 1px 2px rgb(0 0 0 / .1); }
  .top__in a { color: var(--ink); text-decoration: none; font-weight: 500; }

  .wrap { max-width: 1232px; margin: 0 auto; padding: 0 24px; }
  .sec { padding: 56px 0; }
  .sec:last-of-type { padding-bottom: 128px; }
  .intro + .sec { padding-top: 112px; }
  .sec__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; margin-bottom: 40px; }
  .sec__head h2 { margin: 0; max-width: 720px; font-size: clamp(30px, 1.6vw + 16px, 40px); line-height: 1.12; letter-spacing: -0.03em; font-weight: 500; text-wrap: balance; }
  .sec__head h2 span { color: var(--muted); }
  .sec__tag { flex: none; font: 500 12px/16px var(--font-mono); color: var(--muted); padding-bottom: 6px; }
  .intro { padding: 96px 0 0; }
  .intro h1 { margin: 0; max-width: 820px; font-size: clamp(38px, 2.6vw + 18px, 56px); line-height: 1.04; letter-spacing: -0.04em; font-weight: 500; text-wrap: balance; }
  .intro p { margin: 20px 0 0; max-width: 620px; font-size: 18px; line-height: 1.55; color: color-mix(in oklab, var(--ink) 80%, var(--bg)); text-wrap: pretty; }

  /* layouts */
  .g2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .bento { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); grid-template-rows: auto auto; gap: 16px; }
  .bento > :first-child { grid-row: span 2; }
  .bento > :first-child .panel { --p-h: 520px; }
  .bento > :not(:first-child) .panel { --p-h: 236px; }
  .g-stat { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 16px; }
  .g3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .g2 .panel { --p-h: 336px; }

  /* stat cards (Figma's "64%"): a title, one big number and a caption, no picture under it; both numbers share
     one size and one box (cards.css), so the captions start level. The 68% is filled with a still grain */
  .card--stat { --knock-size: clamp(96px, 7vw + 24px, 128px); }
  .card--stat .knock, .card--stat .stat__num { margin-top: 20px; }
  .card--stat .stat__label { margin-top: 16px; max-width: 34ch; }

  /* testimonial: the quote beside one result */
  .card--quote { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 380px); gap: 40px; align-items: stretch; }
  .card--quote .card__body { display: flex; flex-direction: column; justify-content: space-between; padding: 8px 0; }

  /* tall cards: the panel on top, each on its own ground; the fragment starts at the top inset and its
     window runs off the panel's bottom edge (.to-edge) */
  .g3 .panel--top { aspect-ratio: auto; height: 376px; min-height: 0; }

  /* inline fragments for the tall cards (built from base.css, as the skill asks for pieces the kit lacks) */
  .mail { width: 100%; overflow: hidden; }
  .mail__bar { display: flex; align-items: center; gap: 8px; height: 44px; padding: 0 12px 0 16px; border-bottom: 1px solid var(--u-line); }
  .mail__bar .ui-icon { color: var(--u-muted); }
  .mail__subj { flex: 1; min-width: 0; font-size: 13px; font-weight: 500; line-height: 20px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mail__msg { display: flex; gap: 10px; padding: 14px 16px 0; }
  .mail__msg > .ui-agent, .mail__msg > .ui-avatar { margin-top: 1px; }
  .mail__col { min-width: 0; }
  .mail__who { display: flex; align-items: baseline; gap: 8px; font-size: 13px; line-height: 20px; }
  .mail__who b { font-weight: 500; }
  .mail__who time { margin-left: auto; font-size: 11px; color: var(--u-soft); }
  .mail__text { margin-top: 2px; font-size: 13px; line-height: 20px; color: var(--u-text-2); }
  .mail__cite { display: inline-flex; align-items: center; gap: 6px; height: 24px; margin-top: 10px; padding: 0 8px 0 6px; border-radius: 6px; font-size: 11px; font-weight: 500; color: var(--u-muted); box-shadow: inset 0 0 0 1px var(--u-line-2); }
  .mail__cite .ui-icon { width: 13px; height: 13px; }
  .widget { width: 100%; overflow: hidden; }
  .widget__head { display: flex; align-items: center; gap: 10px; height: 56px; padding: 0 14px; background: var(--u-ink); color: var(--u-bg); border-radius: calc(var(--u-r) - 1px) calc(var(--u-r) - 1px) 0 0; }
  .widget__head .ui-agent { width: 28px; height: 28px; background: var(--u-bg); }
  .widget__head .ui-agent::after { background: var(--u-ink); }
  .widget__head b { display: block; font-size: 13px; font-weight: 500; line-height: 18px; }
  .widget__head small { display: block; font-size: 11px; line-height: 16px; opacity: .7; }
  .widget__body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; padding: 14px 12px; }
  .widget__bot, .widget__me { max-width: min(248px, 88%); padding: 8px 12px; font-size: 13px; line-height: 20px; }
  .widget__bot { justify-self: start; border-radius: 4px 14px 14px 14px; background: var(--u-fill-2); color: var(--u-text-2); }
  .widget__me { justify-self: end; border-radius: 14px 14px 4px 14px; background: var(--u-ink); color: var(--u-bg); }
  .widget__order { display: flex; align-items: center; gap: 10px; justify-self: start; width: min(248px, 100%); padding: 10px 10px 10px 12px; border-radius: 10px; background: var(--u-bg); box-shadow: inset 0 0 0 1px var(--u-line-2); }
  .widget__order > .ui-icon { color: var(--u-muted); }
  .widget__order > span:not(.ui-chip) { display: grid; flex: 1; min-width: 0; }
  .widget__order b { font-size: 13px; font-weight: 500; line-height: 18px; }
  .widget__order small { font-size: 12px; line-height: 16px; color: var(--u-muted); }


  /* developer tools: the terminal needs 352px of panel (40px down, 24px of ground under it), the board 360px */
  .g2--dev .panel { --p-h: 352px; }
  .card--wide .panel { --p-h: 360px; }

  .foot { padding-block: 64px 96px; color: var(--muted); font-size: 13px; line-height: 20px; }

  @media (max-width: 1023px) {
    .bento, .g-stat { grid-template-columns: minmax(0, 1fr); }
    .bento > :first-child { grid-row: auto; }
    .bento > :first-child .panel { --p-h: 420px; }
    /* tablet: cards with a panel take the full row, so no row is ever half empty */
    .g2, .g3 { grid-template-columns: minmax(0, 1fr); }
    .card--quote { grid-template-columns: minmax(0, 1fr); gap: 32px; }
  }
  @media (max-width: 760px) {
    .g2, .g3 { grid-template-columns: minmax(0, 1fr); }
    .sec { padding-block: 40px; }
    .intro + .sec { padding-top: 80px; }
    .sec__head { margin-bottom: 28px; }
    .sec__tag { display: none; }
    .intro { padding-top: 56px; }
    .top__note { display: none; }
    .wrap, .top__in { padding: 0 16px; }
    .g2 .panel { --p-h: 320px; }
    .bento > :first-child .panel { --p-h: 380px; }
    /* the small bento fragments are about 250px tall and start 24px down: a 240px panel cuts them by
       30px or more, through the fade (never a sliver of ground under them) */
    .bento > :not(:first-child) .panel { --p-h: 240px; }
    .g3 .panel--top { height: 360px; }
    .g2--dev .panel { --p-h: 372px; }
    .card--wide .panel { --p-h: 372px; }
  }
</style>
</head>
<body>
<header class="top">
  <div class="top__in">
    <span class="top__name">Feature cards</span>
    <span class="top__note">Nine card layouts, in light and dark</span>
