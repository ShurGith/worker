      selectedElement = mountTarget.firstElementChild || mountTarget;
      setLiveState('CYCLING');
      recoveryWaitingForAnchor = false;
      hideShaderOverlay();
      showOrUpdateCyclingBar();
      disableInlineEdit();
      refreshParamsPanel();
      positionBar();
      saveSession();
      completeParameterGenerationIfReady();
