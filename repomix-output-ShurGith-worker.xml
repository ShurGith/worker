function readIndex() { try { return JSON.parse(fs.readFileSync(INDEX, 'utf8')); } catch { return buildIndex({ quiet: true, write: false }); } }

/* ------------------------------------------------------------------ PNG (8-bit RGB/RGBA) */
function decodePNG(buf) {
