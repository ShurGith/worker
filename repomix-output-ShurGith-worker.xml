    // an orbit of logos needs no names under them (the mark is the name); glyphs and letters do
    const ringLabels = sp.labels ?? (L === 'ring' && m.spokes.some(id => !/^[a-z0-9-]+$|^(logos|brands|file|si):/.test(m.nodes.get(id).icon || 'ui:')));
