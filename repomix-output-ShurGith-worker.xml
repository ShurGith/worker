  const root = document.documentElement;
  const q = new URLSearchParams(location.search);
  const U = 'https://unsplash.com/license', CC0 = 'https://creativecommons.org/publicdomain/zero/1.0/';
  const SRC = {
    roof: { id: 618, ratio: 1.5, alt: 'Curving glass and steel lattice roof in black and white', by: 'Mika Ruusunen', licence: 'Unsplash licence', licenceUrl: U, page: 'https://unsplash.com/photos/ypVM8PnygUo' },
    lattice: { id: 893, ratio: 1.5, alt: 'Curved latticed building facade forming sweeping lines', by: 'Samuel Zeller', licence: 'Unsplash licence', licenceUrl: U, page: 'https://unsplash.com/photos/j0g8taxHZa0' },
    spirals: [
      { id: 949, ratio: 0.66, alt: 'A white spiral atrium under a glass dome, seen from below', by: 'Drew Patrick Miller', licence: 'Unsplash licence', licenceUrl: U, page: 'https://unsplash.com/photos/VLT62-JzddA' },
      { id: 679, ratio: 1, alt: 'Spiralling concrete curves around a small round window', by: 'Len dela Cruz', licence: 'Unsplash licence', licenceUrl: U, page: 'https://unsplash.com/photos/ScEKf8u7y-c' },
    ],
    dahlia: { id: 'commons-minimal-orange-dahlia', source: 'commons', ratio: 1.523, width: 5830, focus: [0.5, 0.5], alt: 'An orange dahlia on a black ground', by: 'Alex Blăjan', licence: 'CC0', licenceUrl: CC0,
      url: 'https://upload.wikimedia.org/wikipedia/commons/5/5e/Minimal_orange_dahlia_%28Unsplash%29.jpg', page: 'https://commons.wikimedia.org/wiki/File:Minimal_orange_dahlia_(Unsplash).jpg' },
  };
  const DEFAULTS = { 'split-reveal': SPLIT, 'dither-sequence': DEFAULT_SEQUENCE, 'dot-object': TULIP, 'exploded-layers': MIXER };
  const lib = await fetch(new URL('./photo-kit/photos.json', import.meta.url)).then(r => r.json()).catch(() => ({ photos: [] }));
  const PHOTOS = Object.fromEntries(lib.photos.map(p => [p.key, p]));

  // ---- palette: the page tokens, a ground's paper and an ink that reads on it
  const tok = n => getComputedStyle(root).getPropertyValue(n).trim();
  const lum = hex => { const h = hex.replace('#', ''); const c = [0, 2, 4].map(i => parseInt(h.slice(i, i + 2), 16) / 255); return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]; };
  function paletteFor(cfg) {
    const bg = tok('--' + (cfg.ground || 'g1')), ink = tok('--ink');
    const light = lum(bg) > 0.4, pageLight = lum(ink) < 0.4;
    const gInk = light ? (pageLight ? ink : '#17181b') : (pageLight ? '#eef0f2' : ink);
    return fx.normalizePalette({ bg, surface: bg, ink: gInk, accent: cfg.sea ? tok('--sea') : tok('--accent'), accentInk: tok('--accent-ink') });
  }

  // ---- mounting
  const slots = [...document.querySelectorAll('[data-slot]')];
  const st = new Map(slots.map(el => [el, { cfg: JSON.parse(el.dataset.slot), near: false, ctrl: null, host: null, busy: false }]));
  const mods = new Map();
  const load = id => { if (!mods.has(id)) mods.set(id, import(`./${id}/object.js`).then(m => m.default)); return mods.get(id); };
  // a photo print may name a darker photograph for the dark palettes (a pale one prints as a light plate there)
  const isDark = () => lum(tok('--bg')) < 0.4;
  const photoKey = cfg => (cfg.photoDark && isDark() ? cfg.photoDark : cfg.photo);
  const srcOf = cfg => {
    if (cfg.kind === 'photo') return new URL('./photo-kit/' + PHOTOS[photoKey(cfg)].file, import.meta.url).href;
    if (!cfg.src) return undefined;
    return cfg.src === 'default' ? DEFAULTS[cfg.id] : SRC[cfg.src];
  };
  // a photo print's slot shows its photograph toned into the ground until the print draws, before it
  // mounts too: never an empty panel, even on a slow device
  function underlay(box, cfg) {
    if (cfg.kind !== 'photo') return;
    const p = PHOTOS[photoKey(cfg)];
    Object.assign(box.style, { backgroundColor: 'var(--pg)', backgroundImage: 'url(' + srcOf(cfg) + ')', backgroundSize: 'cover',
      backgroundPosition: (p.focus[0] * 100) + '% ' + (p.focus[1] * 100) + '%', backgroundBlendMode: 'luminosity' });
  }
  async function mount(el) {
    const s = st.get(el);
    s.busy = true;
    try {
      const obj = await load(s.cfg.id);
      if (!s.want) return;
      const host = document.createElement('div');
      host.className = 'host';
      if (el.hasAttribute('aria-label')) host.setAttribute('aria-label', el.getAttribute('aria-label'));
      el.appendChild(host);
      const cfg = s.cfg, palette = paletteFor(cfg);
      let ctrl;
      if (cfg.kind === 'print') ctrl = obj.mount(host, { place: cfg.place, params: cfg.params || {}, palette });
      else if (cfg.kind === 'photo') {
        const p = PHOTOS[photoKey(cfg)];
        s.photo = photoKey(cfg);
        underlay(host, cfg);
        ctrl = obj.mount(host, { palette, src: srcOf(cfg), params: { focusX: p.focus[0], focusY: p.focus[1], ...(cfg.params || {}) } });
      } else ctrl = obj.mount(host, { palette, src: srcOf(cfg), params: cfg.params || {} });
      s.ctrl = ctrl; s.host = host;
    } catch (e) { console.warn('objects:', s.cfg.id, e); }
    finally { s.busy = false; if (!s.want && s.ctrl) unmount(el); schedule(); }
  }
  function unmount(el) {
    const s = st.get(el);
    if (!s.ctrl) return;
    try { s.ctrl.destroy(); } catch (e) { console.warn(e); }
    s.host?.remove();
    s.ctrl = null; s.host = null;
  }
  let queued = 0;
  function reconcile() {
    queued = 0;
    const mid = innerHeight / 2;
    const dist = el => { const r = el.getBoundingClientRect(); return Math.abs((r.top + r.bottom) / 2 - mid); };
    // the nearest first, at most MAX, and at most CAP of one family (photo-kit warns past 3)
    const near = [], kinds = {};
    for (const el of slots.filter(e => st.get(e).near).sort((a, b) => dist(a) - dist(b))) {
      const k = st.get(el).cfg.kind;
      if (near.length < MAX && (kinds[k] || 0) < CAP[k]) { near.push(el); kinds[k] = (kinds[k] || 0) + 1; }
    }
    const want = new Set(near);
    for (const el of slots) { const s = st.get(el); s.want = want.has(el); if (!s.want && s.ctrl && !s.busy) unmount(el); }
    // never more than MAX mounted (or mounting) at once
    let count = slots.filter(el => { const s = st.get(el); return s.ctrl || s.busy; }).length;
    for (const el of near) { const s = st.get(el); if (!s.ctrl && !s.busy && count < MAX) { count++; mount(el); } }
  }
  const schedule = () => { if (!queued) queued = requestAnimationFrame(reconcile); };
  const io = new IntersectionObserver(es => { for (const e of es) st.get(e.target).near = e.isIntersecting; schedule(); }, { rootMargin: '60% 0px' });
  slots.forEach(el => io.observe(el));
  addEventListener('scroll', schedule, { passive: true });
  addEventListener('resize', schedule, { passive: true });

  // ---- palette switch
  const PAL = ['paper', 'stone', 'graphite', 'night'];
  const label = document.getElementById('sw-label');
  function setPalette(name, save) {
    if (!PAL.includes(name)) name = 'paper';
    root.dataset.palette = name;
    for (const b of document.querySelectorAll('[data-pal]')) b.setAttribute('aria-pressed', String(b.dataset.pal === name));
    label.textContent = name[0].toUpperCase() + name.slice(1);
    for (const [el, s] of st) {
      if (s.ctrl && s.cfg.kind === 'photo' && s.photo !== photoKey(s.cfg)) unmount(el);   // its photograph changes: mount it again
      else if (s.ctrl?.setPalette) s.ctrl.setPalette(paletteFor(s.cfg));
    }
    for (const [el, s] of st) underlay(el, s.cfg);
    schedule();
    if (save) try { localStorage.setItem('objects-palette', name); } catch (_) { /* private window */ }
  }
  let saved = null;
  try { saved = localStorage.getItem('objects-palette'); } catch (_) { /* private window */ }
  setPalette(q.get('palette') || saved || 'paper');
  document.querySelector('.swatches').addEventListener('click', e => { const b = e.target.closest('[data-pal]'); if (b) setPalette(b.dataset.pal, true); });

  // ---- copy a mount snippet
  document.addEventListener('click', async e => {
    const b = e.target.closest('.copy');
    if (!b) return;
    try { await navigator.clipboard.writeText(b.dataset.copy); } catch (_) { /* no clipboard: the button still answers */ }
    b.classList.add('done');
    clearTimeout(b._t); b._t = setTimeout(() => b.classList.remove('done'), 1400);
  });

  // ---- the one credit line
  const pk = ['lamp', 'concrete', 'platform', 'room'].map(k => PHOTOS[k]).filter(Boolean).map(p => ({ ...p, adapted: true }));
  const sc = [SPLIT, ...DEFAULT_SEQUENCE, TULIP, MIXER, SRC.roof, SRC.lattice, ...SRC.spirals, SRC.dahlia]
    .map(p => ({ ...p, source: p.source === 'commons' ? 'Wikimedia Commons' : (p.source || 'Unsplash'), adapted: true }));
  const seen = new Set();
  document.getElementById('credits').innerHTML = creditsLine([...pk, ...sc].filter(p => { const k = p.page || p.by; if (seen.has(k)) return false; seen.add(k); return true; }));

  // fetch every object's module and the photographs while the page is idle, so a panel mounts at once
  const prefetch = () => {
    const ids = [...new Set([...st.values()].map(s => s.cfg.id))];
    let i = 0;
    const next = () => { if (i < ids.length) load(ids[i++]).catch(() => {}).finally(() => setTimeout(next, 80)); };
    next();
    for (const p of Object.values(PHOTOS)) { const im = new Image(); im.decoding = 'async'; im.src = new URL('./photo-kit/' + p.file, import.meta.url).href; }
  };
  (window.requestIdleCallback || ((f) => setTimeout(f, 600)))(prefetch, { timeout: 1500 });

  window.__objects = { st, live: () => [...st.values()].filter(s => s.ctrl).length };
  if (document.fonts) await document.fonts.ready;
  root.dataset.ready = '1';
</script>
