    // up to 4 branches; with more it is drawn as the mind map (a web of 5+ branches crowds its leaves)
    const radialOK = sp.shape === 'radial' && L === 'hub' && m.spokes.length <= 4;
    const attempt = (level, t, v, tight) => {
