  const help = form.querySelector('[aria-live]');
  const fields = [...form.querySelectorAll('input[required]')];
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const bad = fields.filter((i) => !i.checkValidity());
    fields.forEach((i) => { i.toggleAttribute('aria-invalid', bad.includes(i)); if (bad.includes(i)) i.setAttribute('aria-describedby', help.id); else i.removeAttribute('aria-describedby'); });
