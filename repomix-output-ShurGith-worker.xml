  .cardlib-load { padding: 64px 0; color: var(--muted); }
  @media (max-width: 760px) { .cardlib .sec__head { flex-direction: column; align-items: flex-start; gap: 10px; } .cardlib .sec__meta { justify-items: start; text-align: left; } .cardlib .sec__meta .sec__tag { display: block; } }

  /* ---------------------------------------------------------------- 3. creative uses: the components */
  .uses { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 104px 24px; }
  /* each part spans two rows of the list (its words, its stage), so two halves side by side start their stages level */
  .use { grid-column: 1 / -1; grid-row: span 2; min-width: 0; display: grid; grid-template-rows: subgrid; row-gap: 28px; scroll-margin-top: 88px; }
  .use.is-half { grid-column: auto; }
  .use__meta { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 4px 12px; align-items: baseline; align-content: start; max-width: 760px; }
  .use__no { font: 500 12px/1 var(--font-mono); color: var(--muted); }
  .use__meta h3 { font: 500 20px/1.3 var(--font-text); letter-spacing: -0.015em; }
  .use__meta p { grid-column: 2; color: var(--muted); font-size: 15px; line-height: 1.55; max-width: 64ch; }
  .use__pick { grid-column: 2; margin-top: 10px; }
  .use__stage { position: relative; min-width: 0; }
  /* a small control on a lit, focal ground (Figma's Texture tile), never on an even one */
  .use__box { position: relative; isolation: isolate; overflow: clip; display: grid; place-items: center; min-height: 400px; padding: 56px 32px; border-radius: 20px; background: var(--card); }
  .use__box::after { content: ""; position: absolute; inset: 0; z-index: 4; border-radius: inherit; pointer-events: none; box-shadow: inset 0 0 0 1px var(--line); }
  .use__ground { position: absolute; inset: 0; z-index: 0; border-radius: inherit; }
  .use__box > .use__stage { z-index: 1; width: 100%; display: grid; justify-items: center; }
  #use-fx-dither-object .use__stage { display: grid; justify-items: center; }
  #use-fx-dither-object .cx-obj { width: min(100%, 760px); }

  /* ---------------------------------------------------------------- 4. real things: objects, photographs, scenes */
  .things { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .things > .card { min-width: 0; }
  .things > .card.is-wide { grid-column: span 2; }
  .things .panel--top { aspect-ratio: auto; height: 340px; min-height: 0; }
  .things .card > p { min-height: 2lh; }
  /* system.css caps every canvas at 100% of its box; a printed object sizes its canvas past the box on purpose */
  .print3d > canvas { max-width: none; }
  .photos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .shot { display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: 14px; margin: 0; min-width: 0; }
  .shot__frame { position: relative; isolation: isolate; overflow: clip; border-radius: 16px; background: var(--card); aspect-ratio: 4 / 5; }
  /* before its print is drawn (or while it waits for a free context) a photograph shows greyed into the page */
  .photos .shot__frame > img { filter: grayscale(1) contrast(1.06); opacity: .92; mix-blend-mode: multiply; }
  html:not([data-kind="light"]) .photos .shot__frame > img { opacity: .85; mix-blend-mode: screen; }
  /* scenes: x.ai's tab list at the left, one stage at the right (one WebGL context, whichever scene is picked) */
  .scene-tabs { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 24px 48px; align-items: start; }
  .scene-list { display: grid; border-top: 1px solid var(--line); }
  .scene-tab { display: grid; gap: 8px; padding: 20px 0; border: 0; border-bottom: 1px solid var(--line); background: none; color: var(--muted); text-align: left; font: inherit; cursor: pointer; }
  .scene-tab b { font: 500 17px/24px var(--font-text); letter-spacing: -0.012em; }
  .scene-tab span { display: none; font-size: 15px; line-height: 1.5; text-wrap: pretty; }
  .scene-tab small { display: none; font-size: 12px; line-height: 1.5; }
