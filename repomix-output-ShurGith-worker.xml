<style>
:root {
  --p-bg: #ffffff; --p-surface: #f3f3f1; --p-ink: #111111; --p-muted: #5f5f5c;
  --p-accent: #e2472b; --p-accent-ink: #ffffff; --p-action: #111111; --p-action-ink: #ffffff;
