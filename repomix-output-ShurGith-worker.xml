<file path=".agents/skills/design-taste-frontend/assets/moments/photo-chapters/moment.css">
/* photo-chapters: at rest (reduced motion, no script, a failed module, a screen under 600px tall) the
   chapters stand side by side under the h2, each photograph over its title and lines; a phone stacks
   them. The section is then as tall as its chapters, one screen at least, at every width: a held
   section's extra screens would stand empty. Live (.is-live, moment.js) the section is (hold + 1)
   screens and its box sticks for the hold: the h2 and lead at the top, one stage of photographs the
   width of the page's edges under them, each uncovered from its foot (--mo-c, the share still
   covered) and settling (--mo-z), and on the stage's lower left a panel in the page's ground with the
   chapter in hand. */
[data-moment="photo-chapters"] { --mo-hold: 2; }
main [data-moment="photo-chapters"][data-moment] > .mo-ph { display: grid; gap: var(--s-7); align-content: start; height: auto; }
main > [data-moment="photo-chapters"][data-moment]:not(.is-live) { height: auto; min-height: 100vh; min-height: 100svh; }
[data-moment="photo-chapters"] .mo-ph__head { display: grid; gap: var(--s-4); max-width: 46ch; }
[data-moment="photo-chapters"] .mo-ph__list { display: grid; gap: var(--s-6) var(--s-5); margin: 0; padding: 0; list-style: none; }
[data-moment="photo-chapters"] .mo-ph__ch { display: grid; gap: var(--s-2); align-content: start; }
[data-moment="photo-chapters"] .mo-ph__pic { margin: 0 0 var(--s-3); border-radius: var(--r-md); overflow: hidden; }
[data-moment="photo-chapters"] .mo-ph__pic > img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
[data-moment="photo-chapters"] .mo-ph__ch h3 { font-family: var(--font-text); font-weight: 500; font-size: var(--t-lead); line-height: 1.3; letter-spacing: -0.01em; color: var(--ink); }
[data-moment="photo-chapters"] .mo-ph__ch p { color: var(--ink); max-width: 44ch; }
[data-moment="photo-chapters"] .mo-ph__words { display: grid; gap: var(--s-2); }
@media (min-width: 640px) {
  [data-moment="photo-chapters"]:not(.is-live) .mo-ph__list { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  [data-moment="photo-chapters"]:not(.is-live) .mo-ph__pic > img { aspect-ratio: 4 / 5; max-height: 44svh; }
}
@media (max-width: 639px) {
  [data-moment="photo-chapters"]:not(.is-live) .mo-ph__pic > img { aspect-ratio: 16 / 10; }
}

/* live */
main > [data-moment="photo-chapters"][data-moment].is-live { height: calc((var(--mo-hold) + 1) * 100vh); height: calc((var(--mo-hold) + 1) * 100svh); min-height: 0; padding: 0; display: block; }
main [data-moment="photo-chapters"][data-moment].is-live > .mo-ph {
  position: sticky; top: 0; height: 100vh; height: 100svh; box-sizing: border-box; overflow: clip;
  padding-top: calc(var(--nav, var(--nav-h, 72px)) + var(--s-6)); padding-bottom: calc(var(--s-6) + var(--bar, 0px));
  grid-template-rows: auto minmax(0, 1fr); gap: var(--s-6); align-content: stretch; }
[data-moment="photo-chapters"].is-live .mo-ph__head { grid-row: 1; }
/* the stage: the photographs stacked, each one above the one before, cut from its top while covered */
[data-moment="photo-chapters"].is-live .mo-ph__stage { grid-row: 2; position: relative; min-height: 0; border-radius: var(--r-lg); overflow: clip; background: var(--surface); }
[data-moment="photo-chapters"].is-live .mo-ph__stage > .mo-ph__pic { position: absolute; inset: 0; margin: 0; border-radius: 0;
  clip-path: inset(var(--mo-c, 0%) 0 0 0); will-change: clip-path; }
[data-moment="photo-chapters"].is-live .mo-ph__stage > .mo-ph__pic > img { width: 100%; height: 100%; aspect-ratio: auto; max-height: none;
  transform: scale(var(--mo-z, 1)); transform-origin: 50% 100%; will-change: transform; }
/* the panel: the page's ground on the photograph, an even inset from the stage's corner; the chapters
   share one cell, so the panel is as tall as the longest and never jumps. The one in hand shows; the
   others wait 8px lower at opacity 0, still read by a screen reader */
[data-moment="photo-chapters"].is-live .mo-ph__panel { position: absolute; z-index: 1; left: var(--s-5); bottom: var(--s-5);
  width: min(440px, calc(100% - 2 * var(--s-5))); box-sizing: border-box; padding: var(--s-6);
  display: grid; gap: var(--s-4); background: var(--bg); color: var(--ink); border-radius: var(--r-md); }
[data-moment="photo-chapters"].is-live .mo-ph__count { margin: 0; font: 500 var(--t-small)/1 var(--font-text); font-variant-numeric: tabular-nums; letter-spacing: .02em; color: var(--muted); }
[data-moment="photo-chapters"].is-live .mo-ph__list { display: grid; gap: 0; }
[data-moment="photo-chapters"].is-live .mo-ph__ch { grid-area: 1 / 1; align-content: start; }
[data-moment="photo-chapters"].is-live .mo-ph__words { opacity: 0; transform: translateY(8px); pointer-events: none;
  transition: opacity 220ms ease, transform 220ms ease; }
[data-moment="photo-chapters"].is-live .mo-ph__ch.is-on .mo-ph__words { opacity: 1; transform: none; pointer-events: auto;
  transition: opacity 420ms cubic-bezier(.22, 1, .36, 1) 60ms, transform 520ms cubic-bezier(.22, 1, .36, 1) 60ms; }
[data-moment="photo-chapters"].is-live .mo-ph__ch h3 { font-family: var(--font-display); font-weight: var(--display-weight, 400); font-size: var(--t-h3, 28px); line-height: 1.15; letter-spacing: var(--display-tracking, -0.02em); }
@media (max-width: 639px) {
  [data-moment="photo-chapters"].is-live .mo-ph__panel { left: var(--s-3); right: var(--s-3); bottom: var(--s-3); width: auto; padding: var(--s-5); gap: var(--s-3); }
}
@media print {
  main > [data-moment="photo-chapters"][data-moment].is-live { height: auto; }
  main [data-moment="photo-chapters"][data-moment].is-live > .mo-ph { position: static; height: auto; display: block; overflow: visible; }
  [data-moment="photo-chapters"].is-live .mo-ph__words { opacity: 1; transform: none; }
  [data-moment="photo-chapters"].is-live .mo-ph__stage { display: grid; gap: var(--s-5); }
  [data-moment="photo-chapters"].is-live .mo-ph__stage > .mo-ph__pic { position: static; clip-path: none; aspect-ratio: 4 / 3; }
  [data-moment="photo-chapters"].is-live .mo-ph__stage > .mo-ph__pic > img { transform: none; }
  [data-moment="photo-chapters"].is-live .mo-ph__panel { position: static; width: auto; }
  [data-moment="photo-chapters"].is-live .mo-ph__ch { grid-area: auto; }
}
</file>

<file path=".agents/skills/design-taste-frontend/assets/moments/photo-chapters/moment.js">
/*
  photo-chapters - a short story told in three to five photographs, one large frame at a time. The
  section holds on screen while the page scrolls: its h2 and lead at the top, below them one big
  photograph the width of the page's edges, and on it, at its lower left, a panel in the page's ground
  with the chapter in hand (its number, a title and two lines). As the reader scrolls, each next
  photograph is uncovered over the one before from its foot upward, settling from a slight zoom, and
  the panel changes to its chapter half way through the wipe. The wipe follows the scrollbar (it runs
  back on the way up) and takes under half of a chapter's share of the scroll; the photograph then
  holds for the rest, so there is time to read. Photo-led and calm: for a place, a product or a
  service (the room, the kitchen, the workshop, a day of a tour). No WebGL, no canvas.

    <section class="section" data-moment="photo-chapters">
      <div class="container mo-ph">
        <div class="mo-ph__head"><h2>A night at the harbour house</h2><p>One line.</p></div>
        <ol class="mo-ph__list">
          <li class="mo-ph__ch">
            <figure class="mo-ph__pic"><img src="…" alt="…" width="1800" height="1200"></figure>
            <h3>Arrive by the coast road</h3>
            <p>Two lines.</p>
          </li>
          …three to five chapters, one photograph each
        </ol>
      </div>
    </section>

  Its height is its own: live the section is (hold + 1) screens, the hold growing with the chapters
  (three chapters hold two screens, four or five hold three: about two thirds of a screen each), and
  at rest it is as tall as its chapters, one screen at least. Write no --h and no data-screen on it:
  the checker and the layout check read a live photo-chapters section (.is-live) as whole screens, four
  at most, and still hold it to that.
  At rest (reduced motion, no script, a failed module, a screen under 600px tall such as a phone
  turned sideways) the chapters stand side by side, each photograph over its title and lines (a phone
  stacks them): the same words and pictures, nothing hidden. Live at every width from 600px of
  height, so a phone held upright gets it too (one picture at a time, a clip and a transform).
  Every chapter's words stay in the page for a screen reader; only the one in hand is shown.
  opts: zoom (the settle, 1.06; 1-1.1).
*/
export const phone = true;

export default function (root, opts, lib) {
  const box = root.querySelector('.mo-ph') || root;
  const list = root.querySelector('.mo-ph__list');
  const chapters = [...root.querySelectorAll('.mo-ph__ch')];
  const pics = chapters.map(c => c.querySelector('.mo-ph__pic'));
  if (!list || chapters.length < 2 || pics.some(p => !p)) return {};
  const homes = pics.map(p => p.parentElement);
  const listHome = { parent: list.parentElement, next: list.nextSibling };
  const zoom = lib.clamp(+opts.zoom || 1.06, 1, 1.1);
  const n = chapters.length;
  // about two thirds of a screen of scroll a chapter, in whole screens so the section stays on the grid
  const hold = n <= 3 ? 2 : 3;
  // each chapter's words in a box of their own, so the live panel can stack them in one place
  chapters.forEach(c => {
    if (c.querySelector(':scope > .mo-ph__words')) return;
    const w = document.createElement('div');
    w.className = 'mo-ph__words';
    [...c.children].filter(el => !el.classList.contains('mo-ph__pic')).forEach(el => w.append(el));
    c.append(w);
  });
  const stage = document.createElement('div');
  stage.className = 'mo-ph__stage';
  const panel = document.createElement('div');
  panel.className = 'mo-ph__panel';
  const count = document.createElement('p');
  count.className = 'mo-ph__count';
  count.setAttribute('aria-hidden', 'true');
  panel.append(count);
  const pad = v => String(v).padStart(2, '0');
  let live = false, scrubber = null, on = -1;
  const fits = () => !lib.reduced() && innerHeight >= 600;
  const show = k => {
    if (k === on) return;
    on = k;
    chapters.forEach((c, i) => c.classList.toggle('is-on', i === k));
    count.textContent = `${pad(k + 1)} / ${pad(n)}`;
  };
  // p 0-1 over the held screens: chapter k owns [k/n, (k+1)/n). Its photograph is uncovered over the
  // 45% of a share that straddles that boundary, then holds; the words change half way through the wipe.
  // The last wipe ends at 0.2 of its share, so the last chapter holds to the section's end
  const draw = p => {
    const seg = 1 / n;
    let k = 0;
    pics.forEach((pic, i) => {
      const u = i === 0 ? 1 : lib.clamp((p - (i - 0.25) * seg) / (0.45 * seg));
      const e = lib.ease.out(u);
      pic.style.setProperty('--mo-c', `${((1 - e) * 100).toFixed(2)}%`);
      pic.style.setProperty('--mo-z', (zoom - (zoom - 1) * e).toFixed(4));
      if (u >= 0.5) k = i;
    });
    show(k);
  };
  const go = () => {
    if (live) return;
    live = true;
    root.style.setProperty('--mo-hold', String(hold));
    pics.forEach(p => stage.append(p));
    panel.append(list);
    stage.append(panel);
    box.append(stage);
    root.classList.add('is-live');
    box.setAttribute('data-edge-free', '');   // live the box is one held screen of the section: the layout check skips it
    draw(0);
    scrubber = lib.scrub(root, draw);
  };
  const rest = () => {
    if (!live) return;
    live = false;
    scrubber?.destroy(); scrubber = null;
    root.classList.remove('is-live');
    root.style.removeProperty('--mo-hold');
    box.removeAttribute('data-edge-free');
    listHome.parent.insertBefore(list, listHome.next);
    pics.forEach((p, i) => { homes[i].prepend(p); p.style.removeProperty('--mo-c'); p.style.removeProperty('--mo-z'); });
    chapters.forEach(c => c.classList.remove('is-on'));
    stage.remove();
    on = -1;
  };
  const sync = () => (fits() ? go() : rest());
  sync();
  let t = 0;
  const onResize = () => { clearTimeout(t); t = setTimeout(sync, 120); };
  addEventListener('resize', onResize);
  const rq = matchMedia('(prefers-reduced-motion: reduce)');
  rq.addEventListener('change', sync);
  return { destroy() { removeEventListener('resize', onResize); rq.removeEventListener('change', sync); rest(); } };
}
